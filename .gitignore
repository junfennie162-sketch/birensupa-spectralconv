# Submission root = this directory

# Build products (.su sources are tracked; rebuild .so locally)
__pycache__/
*.py[cod]
*.o
*.so
*.a
*.egg-info/
build/
dist/

# Editor
.DS_Store
*.swp
.idea/
.vscode/
.env
.env.*

# Official NS tensors (~376 MB) — bring your own
fno_ns/data/*.pt

# Checkpoints: formal public demo + demo batch only
fno_ns/checkpoints/*.pt
!fno_ns/checkpoints/fno_ns_public_demo.pt
!fno_ns/checkpoints/demo_batch.pt
fno_ns/results/

# Large local archives
results/archives/
results/PPT_CLOUD*.zip
results/ppt_handoff_*/
spectral_conv/logs/

# Probe history
results/run_logs/_history/**
!results/run_logs/_history/README.md
results/run_logs/*.pid
results/run_logs/*_nohup.out
results/run_logs/*_runner.out

# Tarballs except the single English pack
*.tar.gz
!contest_submit/*.tar.gz
