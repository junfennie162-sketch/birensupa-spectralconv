#include <supa.h>
#include <supa_device.h>

// Single-corner (baseline API)
__global__ void spectral_mul_kernel(int batch_size, int channels_in, int channels_out,
                                    int modes1, int modes2,
                                    const float *__restrict__ x_freq,
                                    const float *__restrict__ weights,
                                    float *__restrict__ y_freq) {
    const int total = batch_size * channels_out * modes1 * modes2;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= total) {
        return;
    }
    const int modes_plane = modes1 * modes2;
    const int out_plane = channels_out * modes_plane;
    const int batch_index = index / out_plane;
    const int rem = index - batch_index * out_plane;
    const int channel_out = rem / modes_plane;
    const int mode_index = rem - channel_out * modes_plane;

    float acc_real = 0.0f;
    float acc_imag = 0.0f;
    const int x_batch_stride = channels_in * modes_plane * 2;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_base =
            batch_index * x_batch_stride + channel_in * modes_plane * 2 + mode_index * 2;
        const int w_base =
            channel_in * w_in_stride + channel_out * w_out_stride + mode_index * 2;
        const float xr = x_freq[x_base + 0];
        const float xi = x_freq[x_base + 1];
        const float wr = weights[w_base + 0];
        const float wi = weights[w_base + 1];
        acc_real += xr * wr - xi * wi;
        acc_imag += xr * wi + xi * wr;
    }
    const int y_base =
        batch_index * channels_out * modes_plane * 2 + channel_out * modes_plane * 2 +
        mode_index * 2;
    y_freq[y_base + 0] = acc_real;
    y_freq[y_base + 1] = acc_imag;
}

// Packed dual-corner: two small corners, one launch (no full-spectrum traffic).
__global__ void spectral_mul_dual_packed_kernel(
    int batch_size, int channels_in, int channels_out, int modes1, int modes2,
    const float *__restrict__ x1, const float *__restrict__ x2,
    const float *__restrict__ w1, const float *__restrict__ w2,
    float *__restrict__ y1, float *__restrict__ y2) {
    const int modes_plane = modes1 * modes2;
    const int per_corner = batch_size * channels_out * modes_plane;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= 2 * per_corner) {
        return;
    }
    const int corner = index / per_corner;
    const int local = index - corner * per_corner;
    const int out_plane = channels_out * modes_plane;
    const int batch_index = local / out_plane;
    const int rem = local - batch_index * out_plane;
    const int channel_out = rem / modes_plane;
    const int mode_index = rem - channel_out * modes_plane;

    const float *x_freq = (corner == 0) ? x1 : x2;
    const float *weights = (corner == 0) ? w1 : w2;
    float *y_freq = (corner == 0) ? y1 : y2;

    float acc_real = 0.0f;
    float acc_imag = 0.0f;
    const int x_batch_stride = channels_in * modes_plane * 2;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_base =
            batch_index * x_batch_stride + channel_in * modes_plane * 2 + mode_index * 2;
        const int w_base =
            channel_in * w_in_stride + channel_out * w_out_stride + mode_index * 2;
        const float xr = x_freq[x_base + 0];
        const float xi = x_freq[x_base + 1];
        const float wr = weights[w_base + 0];
        const float wi = weights[w_base + 1];
        acc_real += xr * wr - xi * wi;
        acc_imag += xr * wi + xi * wr;
    }
    const int y_base =
        batch_index * channels_out * modes_plane * 2 + channel_out * modes_plane * 2 +
        mode_index * 2;
    y_freq[y_base + 0] = acc_real;
    y_freq[y_base + 1] = acc_imag;
}

extern "C" suError_t launch_spectral_mul(const float *d_x_freq, const float *d_weights,
                                         float *d_y_freq, int batch_size, int channels_in,
                                         int channels_out, int modes1, int modes2,
                                         suStream_t stream) {
    if (batch_size <= 0 || channels_in <= 0 || channels_out <= 0 || modes1 <= 0 ||
        modes2 <= 0 || d_x_freq == nullptr || d_weights == nullptr || d_y_freq == nullptr) {
        return suErrorInvalidValue;
    }
    const int total = batch_size * channels_out * modes1 * modes2;
    dim3 block(256);
    dim3 grid((static_cast<unsigned>(total) + block.x - 1) / block.x);
    spectral_mul_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels_in, channels_out, modes1, modes2, d_x_freq, d_weights,
        d_y_freq);
    return suGetLastError();
}

extern "C" suError_t launch_spectral_mul_dual_packed(
    const float *d_x1, const float *d_x2, const float *d_w1, const float *d_w2,
    float *d_y1, float *d_y2, int batch_size, int channels_in, int channels_out,
    int modes1, int modes2, suStream_t stream) {
    if (batch_size <= 0 || channels_in <= 0 || channels_out <= 0 || modes1 <= 0 ||
        modes2 <= 0 || d_x1 == nullptr || d_x2 == nullptr || d_w1 == nullptr ||
        d_w2 == nullptr || d_y1 == nullptr || d_y2 == nullptr) {
        return suErrorInvalidValue;
    }
    const int total = 2 * batch_size * channels_out * modes1 * modes2;
    dim3 block(256);
    dim3 grid((static_cast<unsigned>(total) + block.x - 1) / block.x);
    spectral_mul_dual_packed_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels_in, channels_out, modes1, modes2, d_x1, d_x2, d_w1, d_w2,
        d_y1, d_y2);
    return suGetLastError();
}
