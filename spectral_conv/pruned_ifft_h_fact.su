    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (118 * 16 + m2) * 2);
      u6r += z.x * wr - z.y * wi;
      u6i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
