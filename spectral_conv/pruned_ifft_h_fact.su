    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (125 * 16 + m2) * 2);
      u5r += z.x * wr - z.y * wi;
      u5i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (126 * 16 + m2) * 2);
      u6r += z.x * wr - z.y * wi;
      u6i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (127 * 16 + m2) * 2);
      u7r += z.x * wr - z.y * wi;
      u7i += z.x * wi + z.y * wr; }
    dft8_plus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i, u4r, u4i, u5r, u5i, u6r, u6i, u7r, u7i);
    float ps, pc;
    sincosf((2.0f * M_PIf) * 16.0f * static_cast<float>(n1) / 128.0f, &ps, &pc);
    const float inv_h = 1.0f / 128.0f;
    {
        const float br = u0r * pc + u0i * ps;
        const float bi = u0i * pc - u0r * ps;
        const int h = n1 + 0;
        const int out = plane + (h * 16 + m2) * 2;
        row_freq[out] = (p0r + br) * inv_h;
        row_freq[out + 1] = (p0i + bi) * inv_h;
    }
    {
        const float br = u1r * pc + u1i * ps;
        const float bi = u1i * pc - u1r * ps;
        const int h = n1 + 16;
