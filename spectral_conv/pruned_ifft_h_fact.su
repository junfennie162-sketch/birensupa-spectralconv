        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (119 * 16 + m2) * 2);
      u7r += z.x * wr - z.y * wi;
      u7i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (120 * 16 + m2) * 2);
      u0r += z.x * wr - z.y * wi;
      u0i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (121 * 16 + m2) * 2);
      u1r += z.x * wr - z.y * wi;
      u1i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (122 * 16 + m2) * 2);
      u2r += z.x * wr - z.y * wi;
      u2i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (123 * 16 + m2) * 2);
      u3r += z.x * wr - z.y * wi;
      u3i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
