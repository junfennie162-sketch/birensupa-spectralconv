        const float bi = u4i * pc - u4r * ps;
        const int h = n1 + 64;
        const int out = plane + (h * 16 + m2) * 2;
        row_freq[out] = (p4r + br) * inv_h;
        row_freq[out + 1] = (p4i + bi) * inv_h;
    }
    {
        const float br = u5r * pc + u5i * ps;
        const float bi = u5i * pc - u5r * ps;
        const int h = n1 + 80;
        const int out = plane + (h * 16 + m2) * 2;
        row_freq[out] = (p5r + br) * inv_h;
        row_freq[out + 1] = (p5i + bi) * inv_h;
