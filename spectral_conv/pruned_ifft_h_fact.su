    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (117 * 16 + m2) * 2);
      u5r += z.x * wr - z.y * wi;
      u5i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
