    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (116 * 16 + m2) * 2);
      u4r += z.x * wr - z.y * wi;
      u4i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
