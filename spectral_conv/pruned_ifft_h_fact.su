    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (13 * 16 + m2) * 2);
      u5r += z.x * wr - z.y * wi;
      u5i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (14 * 16 + m2) * 2);
      u6r += z.x * wr - z.y * wi;
      u6i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (15 * 16 + m2) * 2);
      u7r += z.x * wr - z.y * wi;
      u7i += z.x * wi + z.y * wr; }
    dft8_plus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i, u4r, u4i, u5r, u5i, u6r, u6i, u7r, u7i);
    const float p0r = u0r;
    const float p0i = u0i;
    u0r = 0.0f;
    u0i = 0.0f;
    const float p1r = u1r;
    const float p1i = u1i;
    u1r = 0.0f;
    u1i = 0.0f;
    const float p2r = u2r;
    const float p2i = u2i;
    u2r = 0.0f;
    u2i = 0.0f;
    const float p3r = u3r;
    const float p3i = u3i;
    u3r = 0.0f;
    u3i = 0.0f;
    const float p4r = u4r;
    const float p4i = u4i;
    u4r = 0.0f;
    u4i = 0.0f;
    const float p5r = u5r;
    const float p5i = u5i;
    u5r = 0.0f;
    u5i = 0.0f;
    const float p6r = u6r;
    const float p6i = u6i;
    u6r = 0.0f;
    u6i = 0.0f;
    const float p7r = u7r;
    const float p7i = u7i;
    u7r = 0.0f;
    u7i = 0.0f;
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (112 * 16 + m2) * 2);
      u0r += z.x; u0i += z.y; }
    wr = step_c;
    wi = step_s;
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (113 * 16 + m2) * 2);
      u1r += z.x * wr - z.y * wi;
      u1i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (114 * 16 + m2) * 2);
      u2r += z.x * wr - z.y * wi;
      u2i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (115 * 16 + m2) * 2);
      u3r += z.x * wr - z.y * wi;
      u3i += z.x * wi + z.y * wr; }
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
