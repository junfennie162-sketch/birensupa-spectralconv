#include <supa.h>
#include <supa_device.h>
#include <math.h>

#ifndef M_PIf
#define M_PIf 3.14159265358979323846f
#endif

#define BF(ar, ai, br, bi, cs, sn) \
    do { \
        const float _tr = (br) * (cs) - (bi) * (sn); \
        const float _ti = (br) * (sn) + (bi) * (cs); \
        const float _ar = (ar); \
        const float _ai = (ai); \
        (br) = _ar - _tr; \
        (bi) = _ai - _ti; \
        (ar) = _ar + _tr; \
        (ai) = _ai + _ti; \
    } while (0)

static __device__ void dft8_minus(float &r0, float &i0, float &r1, float &i1, float &r2, float &i2, float &r3, float &i3, float &r4, float &i4, float &r5, float &i5, float &r6, float &i6, float &r7, float &i7) {
    { const float tr = r1; r1 = r4; r4 = tr; const float ti = i1; i1 = i4; i4 = ti; }
    { const float tr = r3; r3 = r6; r6 = tr; const float ti = i3; i3 = i6; i6 = ti; }
    BF(r0, i0, r1, i1, 1.0f, 0.0f);
    BF(r2, i2, r3, i3, 1.0f, 0.0f);
    BF(r4, i4, r5, i5, 1.0f, 0.0f);
    BF(r6, i6, r7, i7, 1.0f, 0.0f);
    BF(r0, i0, r2, i2, 1.0f, 0.0f);
    BF(r1, i1, r3, i3, 0.0f, -1.0f);
    BF(r4, i4, r6, i6, 1.0f, 0.0f);
    BF(r5, i5, r7, i7, 0.0f, -1.0f);
    BF(r0, i0, r4, i4, 1.0f, 0.0f);
    BF(r1, i1, r5, i5, 0.707106781f, -0.707106781f);
    BF(r2, i2, r6, i6, 0.0f, -1.0f);
    BF(r3, i3, r7, i7, -0.707106781f, -0.707106781f);
}

__global__ void pruned_rfft2_fused_mixed128_kernel(int batch_size, int channels,
                       const float *__restrict__ x, float *__restrict__ packed) {
    __shared__ float2 Z[16][16][8];
    __shared__ float2 row[128][16];
    const int tid = static_cast<int>(threadIdx.x);
    const int n1 = tid & 15;
    const int local_row = tid >> 4;
    const int plane_idx = static_cast<int>(blockIdx.x);
    const int ch = plane_idx % channels;
    const int b = plane_idx / channels;
    const int plane = b * channels + ch;

    for (int tile = 0; tile < 8; ++tile) {
        const int h = tile * 16 + local_row;
        const int x_base = (plane * 128 + h) * 128;
        float u0r = x[x_base + n1 + 0];
        float u0i = 0.0f;
        float u1r = x[x_base + n1 + 16];
        float u1i = 0.0f;
        float u2r = x[x_base + n1 + 32];
        float u2i = 0.0f;
        float u3r = x[x_base + n1 + 48];
        float u3i = 0.0f;
        float u4r = x[x_base + n1 + 64];
        float u4i = 0.0f;
        float u5r = x[x_base + n1 + 80];
        float u5i = 0.0f;
        float u6r = x[x_base + n1 + 96];
        float u6i = 0.0f;
        float u7r = x[x_base + n1 + 112];
        float u7i = 0.0f;
        dft8_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i, u4r, u4i, u5r, u5i, u6r, u6i, u7r, u7i);
        Z[local_row][n1][0].x = u0r;
        Z[local_row][n1][0].y = u0i;
        Z[local_row][n1][1].x = u1r;
        Z[local_row][n1][1].y = u1i;
        Z[local_row][n1][2].x = u2r;
        Z[local_row][n1][2].y = u2i;
        Z[local_row][n1][3].x = u3r;
        Z[local_row][n1][3].y = u3i;
        Z[local_row][n1][4].x = u4r;
        Z[local_row][n1][4].y = u4i;
        Z[local_row][n1][5].x = u5r;
        Z[local_row][n1][5].y = u5i;
        Z[local_row][n1][6].x = u6r;
        Z[local_row][n1][6].y = u6i;
        Z[local_row][n1][7].x = u7r;
        Z[local_row][n1][7].y = u7i;
        __syncthreads();
        const int m2 = n1;
        const int bin = m2 & 7;
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float step_s, step_c;
        sincosf(-(2.0f * M_PIf) * static_cast<float>(m2) / 128.0f, &step_s, &step_c);
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[local_row][n1s][bin].x;
            const float zi = Z[local_row][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        row[h][m2].x = acc_r;
        row[h][m2].y = acc_i;
        __syncthreads();
    }

    const int m2 = n1;
    const int n1h = local_row;
    float u0r = row[n1h + 0][m2].x;
    float u0i = row[n1h + 0][m2].y;
    float u1r = row[n1h + 16][m2].x;
    float u1i = row[n1h + 16][m2].y;
    float u2r = row[n1h + 32][m2].x;
    float u2i = row[n1h + 32][m2].y;
    float u3r = row[n1h + 48][m2].x;
    float u3i = row[n1h + 48][m2].y;
    float u4r = row[n1h + 64][m2].x;
    float u4i = row[n1h + 64][m2].y;
    float u5r = row[n1h + 80][m2].x;
    float u5i = row[n1h + 80][m2].y;
    float u6r = row[n1h + 96][m2].x;
    float u6i = row[n1h + 96][m2].y;
    float u7r = row[n1h + 112][m2].x;
    float u7i = row[n1h + 112][m2].y;
    dft8_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i, u4r, u4i, u5r, u5i, u6r, u6i, u7r, u7i);
    Z[m2][n1h][0].x = u0r;
    Z[m2][n1h][0].y = u0i;
    Z[m2][n1h][1].x = u1r;
    Z[m2][n1h][1].y = u1i;
    Z[m2][n1h][2].x = u2r;
    Z[m2][n1h][2].y = u2i;
    Z[m2][n1h][3].x = u3r;
    Z[m2][n1h][3].y = u3i;
    Z[m2][n1h][4].x = u4r;
    Z[m2][n1h][4].y = u4i;
    Z[m2][n1h][5].x = u5r;
    Z[m2][n1h][5].y = u5i;
    Z[m2][n1h][6].x = u6r;
    Z[m2][n1h][6].y = u6i;
    Z[m2][n1h][7].x = u7r;
    Z[m2][n1h][7].y = u7i;
    __syncthreads();
    const int m1 = n1h;
    const int bin = m1 & 7;
    float step_s, step_c;
    sincosf(-(2.0f * M_PIf) * static_cast<float>(m1) / 128.0f, &step_s, &step_c);
    {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2][n1s][bin].x;
            const float zi = Z[m2][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        const int out_idx = (plane * 128 + m1) * 32 + m2 * 2;
        packed[out_idx] = acc_r;
        packed[out_idx + 1] = acc_i;
    }
    sincosf(-(2.0f * M_PIf) * static_cast<float>(112 + m1) / 128.0f, &step_s, &step_c);
    {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2][n1s][bin].x;
            const float zi = Z[m2][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        const int out_idx = (plane * 128 + 112 + m1) * 32 + m2 * 2;
        packed[out_idx] = acc_r;
        packed[out_idx + 1] = acc_i;
    }
}

extern "C" suError_t launch_pruned_rfft2_fused_mixed128(const float *x, float *packed,
                                                       int batch_size, int channels,
                                                       suStream_t stream) {
    dim3 block(256);
    dim3 grid(static_cast<unsigned>(batch_size * channels));
    pruned_rfft2_fused_mixed128_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, x, packed);
    return suGetLastError();
}
