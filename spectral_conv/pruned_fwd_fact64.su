#include <supa.h>
#include <supa_device.h>
#include <math.h>

#ifndef M_PIf
#define M_PIf 3.14159265358979323846f
#endif

#define BF(ar, ai, br, bi, cs, sn) \
    do { \
        const float _tr = (br) * (cs) - (bi) * (sn); \
        const float _ti = (br) * (sn) + (bi) * (cs); \
        const float _ar = (ar); \
        const float _ai = (ai); \
        (br) = _ar - _tr; \
        (bi) = _ai - _ti; \
        (ar) = _ar + _tr; \
        (ai) = _ai + _ti; \
    } while (0)

static __device__ void dft4_minus(float &r0, float &i0, float &r1, float &i1, float &r2, float &i2, float &r3, float &i3) {
    { const float tr = r1; r1 = r2; r2 = tr; const float ti = i1; i1 = i2; i2 = ti; }
    // stage 1 len=2
    BF(r0, i0, r1, i1, 1.0f, 0.0f);
    BF(r2, i2, r3, i3, 1.0f, 0.0f);
    // stage 2 len=4
    BF(r0, i0, r2, i2, 1.0f, 0.0f);
    BF(r1, i1, r3, i3, 0.0f, -1.0f);
}

__global__ void pruned_rfft_w_m16_fact16x4_w64_kernel(int batch_size, int channels, int height,
                       const float *__restrict__ x, float *__restrict__ row_freq) {
    __shared__ float2 Z[8][16][4];
    const int tid = static_cast<int>(threadIdx.x);
    const int n1 = tid & 15;
    const int local_row = tid >> 4;
    const int row0 = static_cast<int>(blockIdx.x) * 8 + local_row;
    const int total_rows = batch_size * channels * height;
    const int valid = row0 < total_rows;
    float u0r, u0i;
    float u1r, u1i;
    float u2r, u2i;
    float u3r, u3i;
    int b = 0, ch = 0, h = 0, x_base = 0;
    if (valid) {
        h = row0 % height;
        int rest = row0 / height;
        ch = rest % channels;
        b = rest / channels;
        x_base = ((b * channels + ch) * height + h) * 64;
        u0r = x[x_base + n1 + 0];
        u0i = 0.0f;
        u1r = x[x_base + n1 + 16];
        u1i = 0.0f;
        u2r = x[x_base + n1 + 32];
        u2i = 0.0f;
        u3r = x[x_base + n1 + 48];
        u3i = 0.0f;
        dft4_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i);
        Z[local_row][n1][0].x = u0r;
        Z[local_row][n1][0].y = u0i;
        Z[local_row][n1][1].x = u1r;
        Z[local_row][n1][1].y = u1i;
        Z[local_row][n1][2].x = u2r;
        Z[local_row][n1][2].y = u2i;
        Z[local_row][n1][3].x = u3r;
        Z[local_row][n1][3].y = u3i;
    }
    __syncthreads();
    if (!valid) {
        return;
    }
    const int m2 = n1;
    const int bin = m2 & 3;
    float acc_r = 0.0f;
    float acc_i = 0.0f;
    float step_s, step_c;
    sincosf(-(2.0f * M_PIf) * static_cast<float>(m2) / 64.0f, &step_s, &step_c);
    float wr = 1.0f;
    float wi = 0.0f;
#pragma unroll
    for (int n1s = 0; n1s < 16; ++n1s) {
        const float zr = Z[local_row][n1s][bin].x;
        const float zi = Z[local_row][n1s][bin].y;
        acc_r += zr * wr - zi * wi;
        acc_i += zr * wi + zi * wr;
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    const int out = ((b * channels + ch) * height + h) * 32 + m2 * 2;
    row_freq[out] = acc_r;
    row_freq[out + 1] = acc_i;
}


__global__ void pruned_fft_h_m16_fact16x4_h64_kernel(int batch_size, int channels,
                       const float *__restrict__ row_freq, float *__restrict__ packed) {
    __shared__ float2 Z[16][16][4];
    const int tid = static_cast<int>(threadIdx.x);
    const int m2_local = tid & 15;
    const int n1 = tid >> 4;
    const int m2 = static_cast<int>(blockIdx.y) * 16 + m2_local;
    const int plane_idx = static_cast<int>(blockIdx.x);
    const int ch = plane_idx % channels;
    const int b = plane_idx / channels;
    const int row_plane = (b * channels + ch) * 64 * 32;
    float u0r, u0i;
    float u1r, u1i;
    float u2r, u2i;
    float u3r, u3i;
    {
        const int h = n1 + 0;
        const int in = row_plane + (h * 16 + m2) * 2;
        u0r = row_freq[in];
        u0i = row_freq[in + 1];
    }
    {
        const int h = n1 + 16;
        const int in = row_plane + (h * 16 + m2) * 2;
        u1r = row_freq[in];
        u1i = row_freq[in + 1];
    }
    {
        const int h = n1 + 32;
        const int in = row_plane + (h * 16 + m2) * 2;
        u2r = row_freq[in];
        u2i = row_freq[in + 1];
    }
    {
        const int h = n1 + 48;
        const int in = row_plane + (h * 16 + m2) * 2;
        u3r = row_freq[in];
        u3i = row_freq[in + 1];
    }
    dft4_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i);
    Z[m2_local][n1][0].x = u0r;
    Z[m2_local][n1][0].y = u0i;
    Z[m2_local][n1][1].x = u1r;
    Z[m2_local][n1][1].y = u1i;
    Z[m2_local][n1][2].x = u2r;
    Z[m2_local][n1][2].y = u2i;
    Z[m2_local][n1][3].x = u3r;
    Z[m2_local][n1][3].y = u3i;
    __syncthreads();
    const int m1 = n1;
    const int bin = m1 & 3;
    float step_s, step_c;
    int out_idx;
    sincosf(-(2.0f * M_PIf) * static_cast<float>(m1) / 64.0f, &step_s, &step_c);
    out_idx = ((b * channels + ch) * 64 + m1) * 32 + m2 * 2;
    {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2_local][n1s][bin].x;
            const float zi = Z[m2_local][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        packed[out_idx] = acc_r;
        packed[out_idx + 1] = acc_i;
    }
    sincosf(-(2.0f * M_PIf) * static_cast<float>(48 + m1) / 64.0f, &step_s, &step_c);
    out_idx = ((b * channels + ch) * 64 + 48 + m1) * 32 + m2 * 2;
    {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2_local][n1s][bin].x;
            const float zi = Z[m2_local][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        packed[out_idx] = acc_r;
        packed[out_idx + 1] = acc_i;
    }
}


extern "C" suError_t launch_pruned_rfft_w_fact16x4_w64(const float *x, float *row_freq,
                                                       int batch_size, int channels, int height,
                                                       suStream_t stream) {
    const unsigned rows = static_cast<unsigned>(batch_size * channels * height);
    dim3 block(128);
    dim3 grid((rows + 7u) / 8u);
    pruned_rfft_w_m16_fact16x4_w64_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, height, x, row_freq);
    return suGetLastError();
}

extern "C" suError_t launch_pruned_fft_h_fact16x4_h64(const float *row_freq, float *packed,
                                                      int batch_size, int channels,
                                                      suStream_t stream) {
    dim3 block(256);
    dim3 grid(static_cast<unsigned>(batch_size * channels));
    pruned_fft_h_m16_fact16x4_h64_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, row_freq, packed);
    return suGetLastError();
}
