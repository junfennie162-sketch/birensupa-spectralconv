        return;
    }
#endif
    u0r = v0r;
    u0i = v0i;
    u1r = v1r;
    u1i = v1i;
    u2r = v2r;
    u2i = v2i;
    u3r = v3r;
    u3i = v3i;
    u4r = v4r;
    u4i = v4i;
    u5r = v5r;
    u5i = v5i;
    u6r = v6r;
    u6i = v6i;
    u7r = v7r;
    u7i = v7i;
    u8r = v8r;
    u8i = v8i;
    u9r = v9r;
    u9i = v9i;
    u10r = v10r;
    u10i = v10i;
    u11r = v11r;
    u11i = v11i;
    u12r = v12r;
    u12i = v12i;
    u13r = v13r;
    u13i = v13i;
    u14r = v14r;
    u14i = v14i;
    u15r = v15r;
    u15i = v15i;
    dft16_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i, u4r, u4i, u5r, u5i, u6r, u6i, u7r, u7i, u8r, u8i, u9r, u9i, u10r, u10i, u11r, u11i, u12r, u12i, u13r, u13i, u14r, u14i, u15r, u15i);
    const int n1h = tid >> 4;
    const int m2 = tid & 15;
    const int m2_local = m2 & 7;
    const int m1 = n1h;
    const int bin = m1 & 15;
    float step_s, step_c;

    if (m2 < 8) {
        Z[m2_local][n1h][0].x = u0r;
        Z[m2_local][n1h][0].y = u0i;
        Z[m2_local][n1h][1].x = u1r;
        Z[m2_local][n1h][1].y = u1i;
        Z[m2_local][n1h][2].x = u2r;
        Z[m2_local][n1h][2].y = u2i;
        Z[m2_local][n1h][3].x = u3r;
        Z[m2_local][n1h][3].y = u3i;
        Z[m2_local][n1h][4].x = u4r;
        Z[m2_local][n1h][4].y = u4i;
        Z[m2_local][n1h][5].x = u5r;
        Z[m2_local][n1h][5].y = u5i;
        Z[m2_local][n1h][6].x = u6r;
        Z[m2_local][n1h][6].y = u6i;
        Z[m2_local][n1h][7].x = u7r;
        Z[m2_local][n1h][7].y = u7i;
        Z[m2_local][n1h][8].x = u8r;
        Z[m2_local][n1h][8].y = u8i;
        Z[m2_local][n1h][9].x = u9r;
        Z[m2_local][n1h][9].y = u9i;
        Z[m2_local][n1h][10].x = u10r;
        Z[m2_local][n1h][10].y = u10i;
        Z[m2_local][n1h][11].x = u11r;
        Z[m2_local][n1h][11].y = u11i;
        Z[m2_local][n1h][12].x = u12r;
        Z[m2_local][n1h][12].y = u12i;
        Z[m2_local][n1h][13].x = u13r;
        Z[m2_local][n1h][13].y = u13i;
        Z[m2_local][n1h][14].x = u14r;
        Z[m2_local][n1h][14].y = u14i;
        Z[m2_local][n1h][15].x = u15r;
        Z[m2_local][n1h][15].y = u15i;
    }
    __syncthreads();
    if (m2 < 8) {
        sincosf(-(2.0f * M_PIf) * static_cast<float>(m1) / 256.0f, &step_s, &step_c);
        {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2_local][n1s][bin].x;
            const float zi = Z[m2_local][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
            const int out_idx = (plane * 256 + m1) * 32 + m2 * 2;
            packed[out_idx] = acc_r;
            packed[out_idx + 1] = acc_i;
        }
        sincosf(-(2.0f * M_PIf) * static_cast<float>(240 + m1) / 256.0f, &step_s, &step_c);
        {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2_local][n1s][bin].x;
            const float zi = Z[m2_local][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
            const int out_idx = (plane * 256 + 240 + m1) * 32 + m2 * 2;
            packed[out_idx] = acc_r;
            packed[out_idx + 1] = acc_i;
        }
    }
    __syncthreads();
    if (m2 >= 8) {
        Z[m2_local][n1h][0].x = u0r;
        Z[m2_local][n1h][0].y = u0i;
        Z[m2_local][n1h][1].x = u1r;
        Z[m2_local][n1h][1].y = u1i;
        Z[m2_local][n1h][2].x = u2r;
        Z[m2_local][n1h][2].y = u2i;
        Z[m2_local][n1h][3].x = u3r;
        Z[m2_local][n1h][3].y = u3i;
        Z[m2_local][n1h][4].x = u4r;
        Z[m2_local][n1h][4].y = u4i;
        Z[m2_local][n1h][5].x = u5r;
        Z[m2_local][n1h][5].y = u5i;
        Z[m2_local][n1h][6].x = u6r;
        Z[m2_local][n1h][6].y = u6i;
        Z[m2_local][n1h][7].x = u7r;
        Z[m2_local][n1h][7].y = u7i;
        Z[m2_local][n1h][8].x = u8r;
        Z[m2_local][n1h][8].y = u8i;
        Z[m2_local][n1h][9].x = u9r;
        Z[m2_local][n1h][9].y = u9i;
        Z[m2_local][n1h][10].x = u10r;
        Z[m2_local][n1h][10].y = u10i;
        Z[m2_local][n1h][11].x = u11r;
        Z[m2_local][n1h][11].y = u11i;
        Z[m2_local][n1h][12].x = u12r;
        Z[m2_local][n1h][12].y = u12i;
        Z[m2_local][n1h][13].x = u13r;
        Z[m2_local][n1h][13].y = u13i;
        Z[m2_local][n1h][14].x = u14r;
        Z[m2_local][n1h][14].y = u14i;
        Z[m2_local][n1h][15].x = u15r;
        Z[m2_local][n1h][15].y = u15i;
    }
    __syncthreads();
    if (m2 >= 8) {
        sincosf(-(2.0f * M_PIf) * static_cast<float>(m1) / 256.0f, &step_s, &step_c);
        {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2_local][n1s][bin].x;
            const float zi = Z[m2_local][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
            const int out_idx = (plane * 256 + m1) * 32 + m2 * 2;
            packed[out_idx] = acc_r;
            packed[out_idx + 1] = acc_i;
        }
        sincosf(-(2.0f * M_PIf) * static_cast<float>(240 + m1) / 256.0f, &step_s, &step_c);
        {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2_local][n1s][bin].x;
            const float zi = Z[m2_local][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
            const int out_idx = (plane * 256 + 240 + m1) * 32 + m2 * 2;
            packed[out_idx] = acc_r;
            packed[out_idx + 1] = acc_i;
        }
    }
}

extern "C" suError_t launch_pruned_rfft2_fused_mixed256(const float *x, float *packed,
                                                       int batch_size, int channels,
                                                       suStream_t stream) {
    dim3 block(256);
    dim3 grid(static_cast<unsigned>(batch_size * channels));
    pruned_rfft2_fused_mixed256_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, x, packed);
    return suGetLastError();
}
