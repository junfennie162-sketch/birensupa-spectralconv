#include <supa.h>
#include <supa_device.h>
#include <math.h>

#ifndef M_PIf
#define M_PIf 3.14159265358979323846f
#endif

#define BF(ar, ai, br, bi, cs, sn) \
    do { \
        const float _tr = (br) * (cs) - (bi) * (sn); \
        const float _ti = (br) * (sn) + (bi) * (cs); \
        const float _ar = (ar); \
        const float _ai = (ai); \
        (br) = _ar - _tr; \
        (bi) = _ai - _ti; \
        (ar) = _ar + _tr; \
        (ai) = _ai + _ti; \
    } while (0)

static __device__ void dft4_minus(float &r0, float &i0, float &r1, float &i1, float &r2, float &i2, float &r3, float &i3) {
    { const float tr = r1; r1 = r2; r2 = tr; const float ti = i1; i1 = i2; i2 = ti; }
    BF(r0, i0, r1, i1, 1.0f, 0.0f);
    BF(r2, i2, r3, i3, 1.0f, 0.0f);
    BF(r0, i0, r2, i2, 1.0f, 0.0f);
    BF(r1, i1, r3, i3, 0.0f, -1.0f);
}

__global__ void pruned_rfft2_fused_mixed64_kernel(int batch_size, int channels,
                       const float *__restrict__ x, float *__restrict__ packed) {
    __shared__ float2 Z[16][16][4];
    __shared__ float2 row[64][16];
    const int tid = static_cast<int>(threadIdx.x);
    const int n1 = tid & 15;
    const int local_row = tid >> 4;
    const int plane_idx = static_cast<int>(blockIdx.x);
    const int ch = plane_idx % channels;
    const int b = plane_idx / channels;
    const int plane = b * channels + ch;

    for (int tile = 0; tile < 4; ++tile) {
        const int h = tile * 16 + local_row;
        const int x_base = (plane * 64 + h) * 64;
        float u0r = x[x_base + n1 + 0];
        float u0i = 0.0f;
        float u1r = x[x_base + n1 + 16];
        float u1i = 0.0f;
        float u2r = x[x_base + n1 + 32];
        float u2i = 0.0f;
        float u3r = x[x_base + n1 + 48];
        float u3i = 0.0f;
        dft4_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i);
        Z[local_row][n1][0].x = u0r;
        Z[local_row][n1][0].y = u0i;
        Z[local_row][n1][1].x = u1r;
        Z[local_row][n1][1].y = u1i;
        Z[local_row][n1][2].x = u2r;
        Z[local_row][n1][2].y = u2i;
        Z[local_row][n1][3].x = u3r;
        Z[local_row][n1][3].y = u3i;
        __syncthreads();
        const int m2 = n1;
        const int bin = m2 & 3;
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float step_s, step_c;
        sincosf(-(2.0f * M_PIf) * static_cast<float>(m2) / 64.0f, &step_s, &step_c);
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[local_row][n1s][bin].x;
            const float zi = Z[local_row][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        row[h][m2].x = acc_r;
        row[h][m2].y = acc_i;
        __syncthreads();
    }

    const int m2 = n1;
    const int n1h = local_row;
    float u0r = row[n1h + 0][m2].x;
    float u0i = row[n1h + 0][m2].y;
    float u1r = row[n1h + 16][m2].x;
    float u1i = row[n1h + 16][m2].y;
    float u2r = row[n1h + 32][m2].x;
    float u2i = row[n1h + 32][m2].y;
    float u3r = row[n1h + 48][m2].x;
    float u3i = row[n1h + 48][m2].y;
    dft4_minus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i);
    Z[m2][n1h][0].x = u0r;
    Z[m2][n1h][0].y = u0i;
    Z[m2][n1h][1].x = u1r;
    Z[m2][n1h][1].y = u1i;
    Z[m2][n1h][2].x = u2r;
    Z[m2][n1h][2].y = u2i;
    Z[m2][n1h][3].x = u3r;
    Z[m2][n1h][3].y = u3i;
    __syncthreads();
    const int m1 = n1h;
    const int bin = m1 & 3;
    float step_s, step_c;
    sincosf(-(2.0f * M_PIf) * static_cast<float>(m1) / 64.0f, &step_s, &step_c);
    {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2][n1s][bin].x;
            const float zi = Z[m2][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        const int out_idx = (plane * 64 + m1) * 32 + m2 * 2;
        packed[out_idx] = acc_r;
        packed[out_idx + 1] = acc_i;
    }
    sincosf(-(2.0f * M_PIf) * static_cast<float>(48 + m1) / 64.0f, &step_s, &step_c);
    {
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int n1s = 0; n1s < 16; ++n1s) {
            const float zr = Z[m2][n1s][bin].x;
            const float zi = Z[m2][n1s][bin].y;
            acc_r += zr * wr - zi * wi;
            acc_i += zr * wi + zi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        const int out_idx = (plane * 64 + 48 + m1) * 32 + m2 * 2;
        packed[out_idx] = acc_r;
        packed[out_idx + 1] = acc_i;
    }
}

extern "C" suError_t launch_pruned_rfft2_fused_mixed64(const float *x, float *packed,
                                                      int batch_size, int channels,
                                                      suStream_t stream) {
    dim3 block(256);
    dim3 grid(static_cast<unsigned>(batch_size * channels));
    pruned_rfft2_fused_mixed64_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, x, packed);
    return suGetLastError();
}
