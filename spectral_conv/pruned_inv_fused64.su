#include <supa.h>
#include <supa_device.h>
#include <math.h>

#ifndef M_PIf
#define M_PIf 3.14159265358979323846f
#endif

#define BF(ar, ai, br, bi, cs, sn) \
    do { \
        const float _tr = (br) * (cs) - (bi) * (sn); \
        const float _ti = (br) * (sn) + (bi) * (cs); \
        const float _ar = (ar); \
        const float _ai = (ai); \
        (br) = _ar - _tr; \
        (bi) = _ai - _ti; \
        (ar) = _ar + _tr; \
        (ai) = _ai + _ti; \
    } while (0)

static __device__ void dft4_plus(float &r0, float &i0, float &r1, float &i1, float &r2, float &i2, float &r3, float &i3) {
    { const float tr = r1; r1 = r2; r2 = tr; const float ti = i1; i1 = i2; i2 = ti; }
    // stage 1 len=2
    BF(r0, i0, r1, i1, 1.0f, 0.0f);
    BF(r2, i2, r3, i3, 1.0f, 0.0f);
    // stage 2 len=4
    BF(r0, i0, r2, i2, 1.0f, 0.0f);
    BF(r1, i1, r3, i3, 0.0f, 1.0f);
}

__global__ void pruned_irfft2_fused_mixed64_kernel(int batch_size, int channels,
                       const float *__restrict__ in_freq, float *__restrict__ spatial) {
    __shared__ float sr[16][16];
    __shared__ float si[16][16];
    const int n1_pair = static_cast<int>(blockIdx.x) % 4;
    int rest = static_cast<int>(blockIdx.x) / 4;
    const int ch = rest % channels;
    const int b = rest / channels;
    const int n1_a = n1_pair * 4;
    const int tid = static_cast<int>(threadIdx.x);
    const int plane = ((b * channels + ch) * 64) * 32;
    if (tid < 64) {
        const int which = tid >> 4;
        const int m2 = tid & 15;
        const int n1 = n1_a + which;
        float u0r = 0.0f;
        float u0i = 0.0f;
        float u1r = 0.0f;
        float u1i = 0.0f;
        float u2r = 0.0f;
        float u2i = 0.0f;
        float u3r = 0.0f;
        float u3i = 0.0f;
        float step_s, step_c, wr, wi;
        sincosf((2.0f * M_PIf) * static_cast<float>(n1) / 64.0f, &step_s, &step_c);
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (0 * 16 + m2) * 2);
          u0r += z.x; u0i += z.y; }
        wr = step_c;
        wi = step_s;
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (1 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (2 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (3 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (4 * 16 + m2) * 2);
          u0r += z.x * wr - z.y * wi;
          u0i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (5 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (6 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (7 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (8 * 16 + m2) * 2);
          u0r += z.x * wr - z.y * wi;
          u0i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (9 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (10 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (11 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (12 * 16 + m2) * 2);
          u0r += z.x * wr - z.y * wi;
          u0i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (13 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (14 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (15 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        dft4_plus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i);
        const float p0r = u0r;
        const float p0i = u0i;
        u0r = 0.0f;
        u0i = 0.0f;
        const float p1r = u1r;
        const float p1i = u1i;
        u1r = 0.0f;
        u1i = 0.0f;
        const float p2r = u2r;
        const float p2i = u2i;
        u2r = 0.0f;
        u2i = 0.0f;
        const float p3r = u3r;
        const float p3i = u3i;
        u3r = 0.0f;
        u3i = 0.0f;
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (48 * 16 + m2) * 2);
          u0r += z.x; u0i += z.y; }
        wr = step_c;
        wi = step_s;
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (49 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (50 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (51 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (52 * 16 + m2) * 2);
          u0r += z.x * wr - z.y * wi;
          u0i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (53 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (54 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (55 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (56 * 16 + m2) * 2);
          u0r += z.x * wr - z.y * wi;
          u0i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (57 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (58 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (59 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (60 * 16 + m2) * 2);
          u0r += z.x * wr - z.y * wi;
          u0i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (61 * 16 + m2) * 2);
          u1r += z.x * wr - z.y * wi;
          u1i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (62 * 16 + m2) * 2);
          u2r += z.x * wr - z.y * wi;
          u2i += z.x * wi + z.y * wr; }
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        { const float2 z = *reinterpret_cast<const float2 *>(in_freq + plane + (63 * 16 + m2) * 2);
          u3r += z.x * wr - z.y * wi;
          u3i += z.x * wi + z.y * wr; }
        dft4_plus(u0r, u0i, u1r, u1i, u2r, u2i, u3r, u3i);
        float ps, pc;
        sincosf((2.0f * M_PIf) * 16.0f * static_cast<float>(n1) / 64.0f, &ps, &pc);
        const float inv_h = 1.0f / 64.0f;
        {
            const float br = u0r * pc + u0i * ps;
            const float bi = u0i * pc - u0r * ps;
            sr[which * 4 + 0][m2] = (p0r + br) * inv_h;
            si[which * 4 + 0][m2] = (p0i + bi) * inv_h;
        }
        {
            const float br = u1r * pc + u1i * ps;
            const float bi = u1i * pc - u1r * ps;
            sr[which * 4 + 1][m2] = (p1r + br) * inv_h;
            si[which * 4 + 1][m2] = (p1i + bi) * inv_h;
        }
        {
            const float br = u2r * pc + u2i * ps;
            const float bi = u2i * pc - u2r * ps;
            sr[which * 4 + 2][m2] = (p2r + br) * inv_h;
            si[which * 4 + 2][m2] = (p2i + bi) * inv_h;
        }
        {
            const float br = u3r * pc + u3i * ps;
            const float bi = u3i * pc - u3r * ps;
            sr[which * 4 + 3][m2] = (p3r + br) * inv_h;
            si[which * 4 + 3][m2] = (p3i + bi) * inv_h;
        }
    }
    __syncthreads();
    const int g = tid >> 4;
    const int n1_w = tid & 15;
    const int h = n1_a + (g >> 2) + (g & 3) * 16;
    const int out_base = ((b * channels + ch) * 64 + h) * 64;
    const float r0 = sr[g][0];
    const float r1 = sr[g][1];
    const float i1 = si[g][1];
    const float r2 = sr[g][2];
    const float i2 = si[g][2];
    const float r3 = sr[g][3];
    const float i3 = si[g][3];
    const float r4 = sr[g][4];
    const float i4 = si[g][4];
    const float r5 = sr[g][5];
    const float i5 = si[g][5];
    const float r6 = sr[g][6];
    const float i6 = si[g][6];
    const float r7 = sr[g][7];
    const float i7 = si[g][7];
    const float r8 = sr[g][8];
    const float i8 = si[g][8];
    const float r9 = sr[g][9];
    const float i9 = si[g][9];
    const float r10 = sr[g][10];
    const float i10 = si[g][10];
    const float r11 = sr[g][11];
    const float i11 = si[g][11];
    const float r12 = sr[g][12];
    const float i12 = si[g][12];
    const float r13 = sr[g][13];
    const float i13 = si[g][13];
    const float r14 = sr[g][14];
    const float i14 = si[g][14];
    const float r15 = sr[g][15];
    const float i15 = si[g][15];
    float b0r = 0.0f;
    float b0i = 0.0f;
    float b1r = 0.0f;
    float b1i = 0.0f;
    float b2r = 0.0f;
    float b2i = 0.0f;
    float b3r = 0.0f;
    float b3i = 0.0f;
    b0r = r0;
    float step_s, step_c;
    sincosf((2.0f * M_PIf) * static_cast<float>(n1_w) / 64.0f, &step_s, &step_c);
    float wr = step_c;
    float wi = step_s;
    b1r += r1 * wr - i1 * wi;
    b1i += r1 * wi + i1 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b2r += r2 * wr - i2 * wi;
    b2i += r2 * wi + i2 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b3r += r3 * wr - i3 * wi;
    b3i += r3 * wi + i3 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b0r += r4 * wr - i4 * wi;
    b0i += r4 * wi + i4 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b1r += r5 * wr - i5 * wi;
    b1i += r5 * wi + i5 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b2r += r6 * wr - i6 * wi;
    b2i += r6 * wi + i6 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b3r += r7 * wr - i7 * wi;
    b3i += r7 * wi + i7 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b0r += r8 * wr - i8 * wi;
    b0i += r8 * wi + i8 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b1r += r9 * wr - i9 * wi;
    b1i += r9 * wi + i9 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b2r += r10 * wr - i10 * wi;
    b2i += r10 * wi + i10 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b3r += r11 * wr - i11 * wi;
    b3i += r11 * wi + i11 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b0r += r12 * wr - i12 * wi;
    b0i += r12 * wi + i12 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b1r += r13 * wr - i13 * wi;
    b1i += r13 * wi + i13 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b2r += r14 * wr - i14 * wi;
    b2i += r14 * wi + i14 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b3r += r15 * wr - i15 * wi;
    b3i += r15 * wi + i15 * wr;
    dft4_plus(b0r, b0i, b1r, b1i, b2r, b2i, b3r, b3i);

    const float invw = 1.0f / 64.0f;
    spatial[out_base + n1_w + 0] = (2.0f * b0r - r0) * invw;
    spatial[out_base + n1_w + 16] = (2.0f * b1r - r0) * invw;
    spatial[out_base + n1_w + 32] = (2.0f * b2r - r0) * invw;
    spatial[out_base + n1_w + 48] = (2.0f * b3r - r0) * invw;
}

extern "C" suError_t launch_pruned_irfft2_fused_mixed64(const float *in_freq, float *spatial,
                                                       int batch_size, int channels,
                                                       suStream_t stream) {
    dim3 block(256);
    dim3 grid(static_cast<unsigned>(batch_size * channels * 4));
    pruned_irfft2_fused_mixed64_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, in_freq, spatial);
    return suGetLastError();
}
