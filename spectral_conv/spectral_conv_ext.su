#include <supa.h>
#include <supa_device.h>
#include <math.h>

// Complex spectral multiply (FNO corner modes):
//   out[b, o, m1, m2] = sum_i x[b, i, m1, m2] * w[i, o, m1, m2]
// Tensors are float2 interleaved as [..., 2] with layout
//   x: [B, Cin, M1, M2, 2]
//   w: [Cin, Cout, M1, M2, 2]
//   y: [B, Cout, M1, M2, 2]
//
// R7: float2 loads + unrolled Cin accumulation; tunable block size.

#ifndef SPECTRAL_MUL_BLOCK
#define SPECTRAL_MUL_BLOCK 256
#endif

__global__ void spectral_mul_kernel(int batch_size, int channels_in, int channels_out,
                                    int modes1, int modes2,
                                    const float *__restrict__ x_freq,
                                    const float *__restrict__ weights,
                                    float *__restrict__ y_freq) {
    const int total = batch_size * channels_out * modes1 * modes2;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= total) {
        return;
    }

    const int modes_plane = modes1 * modes2;
    const int out_plane = channels_out * modes_plane;
    const int batch_index = index / out_plane;
    const int rem = index - batch_index * out_plane;
    const int channel_out = rem / modes_plane;
    const int mode_index = rem - channel_out * modes_plane;

    float acc_real = 0.0f;
    float acc_imag = 0.0f;

    const int x_batch_stride = channels_in * modes_plane * 2;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    const int x_batch_base = batch_index * x_batch_stride + mode_index * 2;
    const int w_out_base = channel_out * w_out_stride + mode_index * 2;

    // Contiguous interleaved pairs → float2 vector loads when aligned.
    const float2 *x2 = reinterpret_cast<const float2 *>(x_freq);
    const float2 *w2 = reinterpret_cast<const float2 *>(weights);

#pragma unroll 4
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_pair =
            (x_batch_base + channel_in * modes_plane * 2) >> 1;
        const int w_pair =
            (channel_in * w_in_stride + w_out_base) >> 1;
        const float2 xv = x2[x_pair];
        const float2 wv = w2[w_pair];
        acc_real += xv.x * wv.x - xv.y * wv.y;
        acc_imag += xv.x * wv.y + xv.y * wv.x;
    }

    const int y_base =
        batch_index * channels_out * modes_plane * 2 + channel_out * modes_plane * 2 +
        mode_index * 2;
    y_freq[y_base + 0] = acc_real;
    y_freq[y_base + 1] = acc_imag;
}

// Write mul result into a corner of full spectrum [B, Cout, H, Wf, 2].
// corner=0 → rows [0, M1); corner=1 → rows [H-M1, H). Cols always [0, M2).
__global__ void spectral_mul_scatter_kernel(
    int batch_size, int channels_in, int channels_out, int modes1, int modes2,
    int height, int width_freq, int corner,
    const float *__restrict__ x_freq, const float *__restrict__ weights,
    float *__restrict__ out_freq) {
    const int total = batch_size * channels_out * modes1 * modes2;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= total) {
        return;
    }

    const int modes_plane = modes1 * modes2;
    const int out_plane = channels_out * modes_plane;
    const int batch_index = index / out_plane;
    const int rem = index - batch_index * out_plane;
    const int channel_out = rem / modes_plane;
    const int mode_index = rem - channel_out * modes_plane;
    const int m1 = mode_index / modes2;
    const int m2 = mode_index - m1 * modes2;
    const int h = (corner == 0) ? m1 : (height - modes1 + m1);

    float acc_real = 0.0f;
    float acc_imag = 0.0f;

    const int x_batch_stride = channels_in * modes_plane * 2;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    const int x_batch_base = batch_index * x_batch_stride + mode_index * 2;
    const int w_out_base = channel_out * w_out_stride + mode_index * 2;

    const float2 *x2 = reinterpret_cast<const float2 *>(x_freq);
    const float2 *w2 = reinterpret_cast<const float2 *>(weights);

#pragma unroll 4
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_pair = (x_batch_base + channel_in * modes_plane * 2) >> 1;
        const int w_pair = (channel_in * w_in_stride + w_out_base) >> 1;
        const float2 xv = x2[x_pair];
        const float2 wv = w2[w_pair];
        acc_real += xv.x * wv.x - xv.y * wv.y;
        acc_imag += xv.x * wv.y + xv.y * wv.x;
    }

    // Contiguous layout [B, Cout, H, Wf, 2]
    const int out_base =
        ((batch_index * channels_out + channel_out) * height + h) * width_freq * 2 +
        m2 * 2;
    out_freq[out_base + 0] = acc_real;
    out_freq[out_base + 1] = acc_imag;
}

// R11: read corner modes from full spectrum [B, Cin, H, Wf, 2] (strided),
// multiply by packed weights, write into out_freq corners — no Python
// `.contiguous()` corner copies.
__global__ void spectral_mul_gather_scatter_kernel(
    int batch_size, int channels_in, int channels_out, int modes1, int modes2,
    int height, int width_freq, int corner,
    const float *__restrict__ x_full, const float *__restrict__ weights,
    float *__restrict__ out_freq) {
    const int total = batch_size * channels_out * modes1 * modes2;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= total) {
        return;
    }

    const int modes_plane = modes1 * modes2;
    const int out_plane = channels_out * modes_plane;
    const int batch_index = index / out_plane;
    const int rem = index - batch_index * out_plane;
    const int channel_out = rem / modes_plane;
    const int mode_index = rem - channel_out * modes_plane;
    const int m1 = mode_index / modes2;
    const int m2 = mode_index - m1 * modes2;
    const int h = (corner == 0) ? m1 : (height - modes1 + m1);

    float acc_real = 0.0f;
    float acc_imag = 0.0f;

    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    const int w_out_base = channel_out * w_out_stride + mode_index * 2;
    // x_full [B, Cin, H, Wf, 2]
    const int x_plane = height * width_freq * 2;
    const int x_batch_base = batch_index * channels_in * x_plane;

    const float2 *w2 = reinterpret_cast<const float2 *>(weights);

#pragma unroll 4
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_base =
            x_batch_base + channel_in * x_plane + h * width_freq * 2 + m2 * 2;
        const float xr = x_full[x_base + 0];
        const float xi = x_full[x_base + 1];
        const int w_pair = (channel_in * w_in_stride + w_out_base) >> 1;
        const float2 wv = w2[w_pair];
        acc_real += xr * wv.x - xi * wv.y;
        acc_imag += xr * wv.y + xi * wv.x;
    }

    const int out_base =
        ((batch_index * channels_out + channel_out) * height + h) * width_freq * 2 +
        m2 * 2;
    out_freq[out_base + 0] = acc_real;
    out_freq[out_base + 1] = acc_imag;
}

// P7: both corners in one launch (saves one kernel launch vs dual R11).
__global__ void spectral_mul_gather_scatter_dual_kernel(
    int batch_size, int channels_in, int channels_out, int modes1, int modes2,
    int height, int width_freq,
    const float *__restrict__ x_full, const float *__restrict__ weights1,
    const float *__restrict__ weights2, float *__restrict__ out_freq) {
    const int single = batch_size * channels_out * modes1 * modes2;
    const int total = single * 2;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= total) {
        return;
    }
    const int corner = index / single;
    const int local = index - corner * single;
    const int modes_plane = modes1 * modes2;
    const int out_plane = channels_out * modes_plane;
    const int batch_index = local / out_plane;
    const int rem = local - batch_index * out_plane;
    const int channel_out = rem / modes_plane;
    const int mode_index = rem - channel_out * modes_plane;
    const int m1 = mode_index / modes2;
    const int m2 = mode_index - m1 * modes2;
    const int h = (corner == 0) ? m1 : (height - modes1 + m1);
    const float *weights = (corner == 0) ? weights1 : weights2;

    float acc_real = 0.0f;
    float acc_imag = 0.0f;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    const int w_out_base = channel_out * w_out_stride + mode_index * 2;
    const int x_plane = height * width_freq * 2;
    const int x_batch_base = batch_index * channels_in * x_plane;
    const float2 *w2 = reinterpret_cast<const float2 *>(weights);

#pragma unroll 4
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_base =
            x_batch_base + channel_in * x_plane + h * width_freq * 2 + m2 * 2;
        const float xr = x_full[x_base + 0];
        const float xi = x_full[x_base + 1];
        const int w_pair = (channel_in * w_in_stride + w_out_base) >> 1;
        const float2 wv = w2[w_pair];
        acc_real += xr * wv.x - xi * wv.y;
        acc_imag += xr * wv.y + xi * wv.x;
    }
    const int out_base =
        ((batch_index * channels_out + channel_out) * height + h) * width_freq * 2 +
        m2 * 2;
    out_freq[out_base + 0] = acc_real;
    out_freq[out_base + 1] = acc_imag;
}

__global__ void spectral_mul_gather_scatter_dual_co2_kernel(
    int batch_size, int channels_in, int channels_out, int modes1, int modes2,
    int height, int width_freq,
    const float *__restrict__ x_full, const float *__restrict__ weights1,
    const float *__restrict__ weights2, float *__restrict__ out_freq) {
    const int cout_pairs = channels_out >> 1;
    const int modes_plane = modes1 * modes2;
    const int single = batch_size * cout_pairs * modes_plane;
    const int total = single * 2;
    const int index = blockIdx.x * blockDim.x + threadIdx.x;
    if (index >= total) {
        return;
    }
    const int corner = index / single;
    const int local = index - corner * single;
    const int pair_plane = cout_pairs * modes_plane;
    const int batch_index = local / pair_plane;
    const int rem = local - batch_index * pair_plane;
    const int pair = rem / modes_plane;
    const int mode_index = rem - pair * modes_plane;
    const int m1 = mode_index / modes2;
    const int m2 = mode_index - m1 * modes2;
    const int h = (corner == 0) ? m1 : (height - modes1 + m1);
    const int co0 = pair << 1;
    const int co1 = co0 + 1;
    const float *weights = (corner == 0) ? weights1 : weights2;

    float acc0r = 0.0f;
    float acc0i = 0.0f;
    float acc1r = 0.0f;
    float acc1i = 0.0f;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_stride = modes_plane * 2;
    const int w0 = co0 * w_out_stride + mode_index * 2;
    const int w1 = co1 * w_out_stride + mode_index * 2;
    const int x_plane = height * width_freq * 2;
    const int x_batch_base = batch_index * channels_in * x_plane;
    const float2 *w2 = reinterpret_cast<const float2 *>(weights);

#pragma unroll 4
    for (int channel_in = 0; channel_in < channels_in; ++channel_in) {
        const int x_base =
            x_batch_base + channel_in * x_plane + h * width_freq * 2 + m2 * 2;
        const float xr = x_full[x_base + 0];
        const float xi = x_full[x_base + 1];
        const int cin_base = channel_in * w_in_stride;
        const float2 wv0 = w2[(cin_base + w0) >> 1];
        const float2 wv1 = w2[(cin_base + w1) >> 1];
        acc0r += xr * wv0.x - xi * wv0.y;
        acc0i += xr * wv0.y + xi * wv0.x;
        acc1r += xr * wv1.x - xi * wv1.y;
        acc1i += xr * wv1.y + xi * wv1.x;
    }
    const int out0 =
        ((batch_index * channels_out + co0) * height + h) * width_freq * 2 + m2 * 2;
    const int out1 =
        ((batch_index * channels_out + co1) * height + h) * width_freq * 2 + m2 * 2;
    out_freq[out0 + 0] = acc0r;
    out_freq[out0 + 1] = acc0i;
    out_freq[out1 + 0] = acc1r;
    out_freq[out1 + 1] = acc1i;
}

__global__ void spectral_mul_tile16_kernel(
    int batch_size, int channels_in, int channels_out, int height, int width_freq,
    const float *__restrict__ x_full, const float *__restrict__ weights1,
    const float *__restrict__ weights2, float *__restrict__ out_freq) {
    __shared__ float xr[32][16];
    __shared__ float xi[32][16];
    const int m2 = static_cast<int>(threadIdx.x) & 15;
    const int co_local = static_cast<int>(threadIdx.x) >> 4;
    const int co_tiles = channels_out >> 4;
    const int tiles_per_batch = 2 * 16 * co_tiles;
    int idx = static_cast<int>(blockIdx.x);
    const int batch_index = idx / tiles_per_batch;
    idx -= batch_index * tiles_per_batch;
    const int corner = idx / (16 * co_tiles);
    idx -= corner * 16 * co_tiles;
    const int m1 = idx / co_tiles;
    const int co_tile = idx - m1 * co_tiles;
    const int co = (co_tile << 4) + co_local;
    const int h = (corner == 0) ? m1 : (height - 16 + m1);
    const int x_plane = height * width_freq * 2;
    const int x_batch_base = batch_index * channels_in * x_plane;
    const int nload = channels_in * 16;
    for (int t = static_cast<int>(threadIdx.x); t < nload; t += 256) {
        const int cin = t >> 4;
        const int km = t & 15;
        const int x_base = x_batch_base + cin * x_plane + h * width_freq * 2 + km * 2;
        xr[cin][km] = x_full[x_base];
        xi[cin][km] = x_full[x_base + 1];
    }
    __syncthreads();
    const float *weights = (corner == 0) ? weights1 : weights2;
    const int modes_plane = 256;
    const int w_in_stride = channels_out * modes_plane * 2;
    const int w_out_base = co * modes_plane * 2 + (m1 * 16 + m2) * 2;
    const float2 *w2 = reinterpret_cast<const float2 *>(weights);
    float acc_r = 0.0f;
    float acc_i = 0.0f;
#pragma unroll 4
    for (int cin = 0; cin < channels_in; ++cin) {
        const float xrv = xr[cin][m2];
        const float xiv = xi[cin][m2];
        const float2 wv = w2[(cin * w_in_stride + w_out_base) >> 1];
        acc_r += xrv * wv.x - xiv * wv.y;
        acc_i += xrv * wv.y + xiv * wv.x;
    }
    const int out_base =
        ((batch_index * channels_out + co) * height + h) * width_freq * 2 + m2 * 2;
    out_freq[out_base] = acc_r;
    out_freq[out_base + 1] = acc_i;
}

extern "C" suError_t launch_spectral_mul(const float *d_x_freq, const float *d_weights,
                                         float *d_y_freq, int batch_size, int channels_in,
                                         int channels_out, int modes1, int modes2,
                                         suStream_t stream) {
    if (batch_size <= 0 || channels_in <= 0 || channels_out <= 0 || modes1 <= 0 ||
        modes2 <= 0 || d_x_freq == nullptr || d_weights == nullptr || d_y_freq == nullptr) {
        return suErrorInvalidValue;
    }

    const int total = batch_size * channels_out * modes1 * modes2;
    dim3 block(SPECTRAL_MUL_BLOCK);
    dim3 grid((static_cast<unsigned>(total) + block.x - 1) / block.x);
    spectral_mul_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels_in, channels_out, modes1, modes2, d_x_freq, d_weights,
        d_y_freq);
    return suGetLastError();
}

extern "C" suError_t launch_spectral_mul_scatter(
    const float *d_x_freq, const float *d_weights, float *d_out_freq, int batch_size,
    int channels_in, int channels_out, int modes1, int modes2, int height,
    int width_freq, int corner, suStream_t stream) {
    if (batch_size <= 0 || channels_in <= 0 || channels_out <= 0 || modes1 <= 0 ||
        modes2 <= 0 || height < modes1 || width_freq < modes2 ||
        (corner != 0 && corner != 1) || d_x_freq == nullptr || d_weights == nullptr ||
        d_out_freq == nullptr) {
        return suErrorInvalidValue;
    }

    const int total = batch_size * channels_out * modes1 * modes2;
    dim3 block(SPECTRAL_MUL_BLOCK);
    dim3 grid((static_cast<unsigned>(total) + block.x - 1) / block.x);
    spectral_mul_scatter_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels_in, channels_out, modes1, modes2, height, width_freq,
        corner, d_x_freq, d_weights, d_out_freq);
    return suGetLastError();
}

extern "C" suError_t launch_spectral_mul_gather_scatter(
    const float *d_x_full, const float *d_weights, float *d_out_freq, int batch_size,
    int channels_in, int channels_out, int modes1, int modes2, int height,
    int width_freq, int corner, suStream_t stream) {
    if (batch_size <= 0 || channels_in <= 0 || channels_out <= 0 || modes1 <= 0 ||
        modes2 <= 0 || height < modes1 || width_freq < modes2 ||
        (corner != 0 && corner != 1) || d_x_full == nullptr || d_weights == nullptr ||
        d_out_freq == nullptr) {
        return suErrorInvalidValue;
    }

    const int total = batch_size * channels_out * modes1 * modes2;
    dim3 block(SPECTRAL_MUL_BLOCK);
    dim3 grid((static_cast<unsigned>(total) + block.x - 1) / block.x);
    spectral_mul_gather_scatter_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels_in, channels_out, modes1, modes2, height, width_freq,
        corner, d_x_full, d_weights, d_out_freq);
    return suGetLastError();
}

extern "C" suError_t launch_spectral_mul_gather_scatter_dual(
    const float *d_x_full, const float *d_w1, const float *d_w2, float *d_out_freq,
    int batch_size, int channels_in, int channels_out, int modes1, int modes2,
    int height, int width_freq, suStream_t stream) {
    if (batch_size <= 0 || channels_in <= 0 || channels_out <= 0 || modes1 <= 0 ||
        modes2 <= 0 || height < modes1 || width_freq < modes2 || d_x_full == nullptr ||
        d_w1 == nullptr || d_w2 == nullptr || d_out_freq == nullptr) {
        return suErrorInvalidValue;
    }
    const int total = batch_size * channels_out * modes1 * modes2 * 2;
    dim3 block(SPECTRAL_MUL_BLOCK);
    dim3 grid((static_cast<unsigned>(total) + block.x - 1) / block.x);
    if (modes1 == 16 && modes2 == 16 && (channels_out & 15) == 0 && channels_in <= 32 &&
        channels_in > 0) {
        const unsigned nblocks = static_cast<unsigned>(batch_size) * 2u * 16u *
                                 static_cast<unsigned>(channels_out >> 4);
        dim3 tgrid(nblocks);
        dim3 tblock(256);
        spectral_mul_tile16_kernel<<<tgrid, tblock, 0, stream>>>(
            batch_size, channels_in, channels_out, height, width_freq, d_x_full, d_w1, d_w2,
            d_out_freq);
        return suGetLastError();
    }
    if ((channels_out & 1) == 0) {
        const int total2 = batch_size * (channels_out >> 1) * modes1 * modes2 * 2;
        dim3 grid2((static_cast<unsigned>(total2) + block.x - 1) / block.x);
        spectral_mul_gather_scatter_dual_co2_kernel<<<grid2, block, 0, stream>>>(
            batch_size, channels_in, channels_out, modes1, modes2, height, width_freq,
            d_x_full, d_w1, d_w2, d_out_freq);
        return suGetLastError();
    }
    spectral_mul_gather_scatter_dual_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels_in, channels_out, modes1, modes2, height, width_freq,
        d_x_full, d_w1, d_w2, d_out_freq);
    return suGetLastError();
}
