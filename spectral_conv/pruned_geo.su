    rem >>= 4;
    const int ch = rem % channels;
    const int b = rem / channels;
    const int kh_bot = 128 - 16 + m1;
    const float two_pi = (2.0f * M_PIf) / static_cast<float>(128);
    float step_ts, step_tc, step_bs, step_bc;
    sincosf(-two_pi * static_cast<float>(m1), &step_ts, &step_tc);
    sincosf(-two_pi * static_cast<float>(kh_bot), &step_bs, &step_bc);
    float acc_tr = 0.0f;
    float acc_ti = 0.0f;
    float acc_br = 0.0f;
    float acc_bi = 0.0f;
    float wr_t = 1.0f;
    float wi_t = 0.0f;
    float wr_b = 1.0f;
    float wi_b = 0.0f;
    const int row_plane = (b * channels + ch) * 128 * 32;
#pragma unroll 8
