            wi = ni;
        }
        acc += 2.0f * (r12 * wr - i12 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r13 * wr - i13 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r14 * wr - i14 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r15 * wr - i15 * wi);
        spatial[out_base + w] = acc / 64.0f;
    }
}


__global__ void pruned_irfft_w_m16_x2_w256_kernel(int batch_size, int channels, int height,
                       const float *__restrict__ row_freq, float *__restrict__ spatial) {
    const int total = batch_size * channels * height * 128;
    const int index = static_cast<int>(blockIdx.x * blockDim.x + threadIdx.x);
    if (index >= total) {
        return;
    }
    const int pair = index & 127;
    int rest = index >> 7;
    const int h = rest % height;
    rest /= height;
    const int ch = rest % channels;
    const int b = rest / channels;
    const int row_base = ((b * channels + ch) * height + h) * 32;
    const float2 z0 = *reinterpret_cast<const float2 *>(row_freq + row_base);
    const float r0 = z0.x;
    const float2 z1 = *reinterpret_cast<const float2 *>(row_freq + row_base + 2);
    const float r1 = z1.x;
    const float i1 = z1.y;
    const float2 z2 = *reinterpret_cast<const float2 *>(row_freq + row_base + 4);
    const float r2 = z2.x;
    const float i2 = z2.y;
    const float2 z3 = *reinterpret_cast<const float2 *>(row_freq + row_base + 6);
    const float r3 = z3.x;
    const float i3 = z3.y;
    const float2 z4 = *reinterpret_cast<const float2 *>(row_freq + row_base + 8);
    const float r4 = z4.x;
    const float i4 = z4.y;
    const float2 z5 = *reinterpret_cast<const float2 *>(row_freq + row_base + 10);
    const float r5 = z5.x;
    const float i5 = z5.y;
    const float2 z6 = *reinterpret_cast<const float2 *>(row_freq + row_base + 12);
    const float r6 = z6.x;
    const float i6 = z6.y;
    const float2 z7 = *reinterpret_cast<const float2 *>(row_freq + row_base + 14);
    const float r7 = z7.x;
    const float i7 = z7.y;
    const float2 z8 = *reinterpret_cast<const float2 *>(row_freq + row_base + 16);
    const float r8 = z8.x;
    const float i8 = z8.y;
    const float2 z9 = *reinterpret_cast<const float2 *>(row_freq + row_base + 18);
    const float r9 = z9.x;
    const float i9 = z9.y;
    const float2 z10 = *reinterpret_cast<const float2 *>(row_freq + row_base + 20);
    const float r10 = z10.x;
    const float i10 = z10.y;
    const float2 z11 = *reinterpret_cast<const float2 *>(row_freq + row_base + 22);
    const float r11 = z11.x;
    const float i11 = z11.y;
    const float2 z12 = *reinterpret_cast<const float2 *>(row_freq + row_base + 24);
    const float r12 = z12.x;
    const float i12 = z12.y;
    const float2 z13 = *reinterpret_cast<const float2 *>(row_freq + row_base + 26);
    const float r13 = z13.x;
    const float i13 = z13.y;
    const float2 z14 = *reinterpret_cast<const float2 *>(row_freq + row_base + 28);
    const float r14 = z14.x;
    const float i14 = z14.y;
    const float2 z15 = *reinterpret_cast<const float2 *>(row_freq + row_base + 30);
    const float r15 = z15.x;
    const float i15 = z15.y;
    const int out_base = ((b * channels + ch) * height + h) * 256;
#pragma unroll
    for (int dw = 0; dw < 2; ++dw) {
        const int w = pair * 2 + dw;
        float acc = r0;
        const float two_pi_w = (2.0f * M_PIf) * static_cast<float>(w) / 256.0f;
        float step_s, step_c;
        sincosf(two_pi_w, &step_s, &step_c);
        float wr = step_c;
        float wi = step_s;
        acc += 2.0f * (r1 * wr - i1 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r2 * wr - i2 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r3 * wr - i3 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r4 * wr - i4 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r5 * wr - i5 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r6 * wr - i6 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r7 * wr - i7 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r8 * wr - i8 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r9 * wr - i9 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r10 * wr - i10 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r11 * wr - i11 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r12 * wr - i12 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r13 * wr - i13 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r14 * wr - i14 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r15 * wr - i15 * wi);
        spatial[out_base + w] = acc / 256.0f;
    }
}


__global__ void pruned_ifft_h_m16_x2_named_kernel(int batch_size, int channels, int height,
                                                  const float *__restrict__ in_freq,
                                                  float *__restrict__ row_freq) {
    const int pairs = height >> 1;
    const int total = batch_size * channels * pairs * 16;
    const int index = static_cast<int>(blockIdx.x * blockDim.x + threadIdx.x);
    if (index >= total) {
        return;
    }
    const int m2 = index & 15;
    int rem = index >> 4;
    const int pair = rem % pairs;
    rem /= pairs;
    const int ch = rem % channels;
    const int b = rem / channels;
    const int plane = ((b * channels + ch) * height) * 32;
    const int kh0 = height - 16;
    const float2 t0 = *reinterpret_cast<const float2 *>(in_freq + plane + (0 * 16 + m2) * 2);
    const float2 t1 = *reinterpret_cast<const float2 *>(in_freq + plane + (1 * 16 + m2) * 2);
    const float2 t2 = *reinterpret_cast<const float2 *>(in_freq + plane + (2 * 16 + m2) * 2);
    const float2 t3 = *reinterpret_cast<const float2 *>(in_freq + plane + (3 * 16 + m2) * 2);
    const float2 t4 = *reinterpret_cast<const float2 *>(in_freq + plane + (4 * 16 + m2) * 2);
    const float2 t5 = *reinterpret_cast<const float2 *>(in_freq + plane + (5 * 16 + m2) * 2);
    const float2 t6 = *reinterpret_cast<const float2 *>(in_freq + plane + (6 * 16 + m2) * 2);
    const float2 t7 = *reinterpret_cast<const float2 *>(in_freq + plane + (7 * 16 + m2) * 2);
    const float2 t8 = *reinterpret_cast<const float2 *>(in_freq + plane + (8 * 16 + m2) * 2);
    const float2 t9 = *reinterpret_cast<const float2 *>(in_freq + plane + (9 * 16 + m2) * 2);
    const float2 t10 = *reinterpret_cast<const float2 *>(in_freq + plane + (10 * 16 + m2) * 2);
    const float2 t11 = *reinterpret_cast<const float2 *>(in_freq + plane + (11 * 16 + m2) * 2);
    const float2 t12 = *reinterpret_cast<const float2 *>(in_freq + plane + (12 * 16 + m2) * 2);
    const float2 t13 = *reinterpret_cast<const float2 *>(in_freq + plane + (13 * 16 + m2) * 2);
    const float2 t14 = *reinterpret_cast<const float2 *>(in_freq + plane + (14 * 16 + m2) * 2);
    const float2 t15 = *reinterpret_cast<const float2 *>(in_freq + plane + (15 * 16 + m2) * 2);
    const float2 b0 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 0) * 16 + m2) * 2);
    const float2 b1 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 1) * 16 + m2) * 2);
    const float2 b2 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 2) * 16 + m2) * 2);
    const float2 b3 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 3) * 16 + m2) * 2);
    const float2 b4 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 4) * 16 + m2) * 2);
    const float2 b5 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 5) * 16 + m2) * 2);
    const float2 b6 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 6) * 16 + m2) * 2);
    const float2 b7 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 7) * 16 + m2) * 2);
    const float2 b8 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 8) * 16 + m2) * 2);
    const float2 b9 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 9) * 16 + m2) * 2);
    const float2 b10 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 10) * 16 + m2) * 2);
    const float2 b11 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 11) * 16 + m2) * 2);
    const float2 b12 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 12) * 16 + m2) * 2);
    const float2 b13 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 13) * 16 + m2) * 2);
    const float2 b14 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 14) * 16 + m2) * 2);
    const float2 b15 = *reinterpret_cast<const float2 *>(in_freq + plane + ((kh0 + 15) * 16 + m2) * 2);
    const float inv_h = 1.0f / static_cast<float>(height);
#pragma unroll
    for (int dw = 0; dw < 2; ++dw) {
        const int h = (pair << 1) + dw;
        const float two_pi_h = (2.0f * M_PIf) * static_cast<float>(h) / static_cast<float>(height);
        float step_s, step_c;
        sincosf(two_pi_h, &step_s, &step_c);
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
        acc_r += t0.x * wr - t0.y * wi;
        acc_i += t0.x * wi + t0.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t1.x * wr - t1.y * wi;
        acc_i += t1.x * wi + t1.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t2.x * wr - t2.y * wi;
        acc_i += t2.x * wi + t2.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t3.x * wr - t3.y * wi;
        acc_i += t3.x * wi + t3.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t4.x * wr - t4.y * wi;
        acc_i += t4.x * wi + t4.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t5.x * wr - t5.y * wi;
        acc_i += t5.x * wi + t5.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t6.x * wr - t6.y * wi;
        acc_i += t6.x * wi + t6.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t7.x * wr - t7.y * wi;
        acc_i += t7.x * wi + t7.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t8.x * wr - t8.y * wi;
        acc_i += t8.x * wi + t8.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t9.x * wr - t9.y * wi;
        acc_i += t9.x * wi + t9.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t10.x * wr - t10.y * wi;
        acc_i += t10.x * wi + t10.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t11.x * wr - t11.y * wi;
        acc_i += t11.x * wi + t11.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t12.x * wr - t12.y * wi;
        acc_i += t12.x * wi + t12.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t13.x * wr - t13.y * wi;
        acc_i += t13.x * wi + t13.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t14.x * wr - t14.y * wi;
        acc_i += t14.x * wi + t14.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += t15.x * wr - t15.y * wi;
        acc_i += t15.x * wi + t15.y * wr;
        sincosf(two_pi_h * static_cast<float>(kh0), &wi, &wr);
        acc_r += b0.x * wr - b0.y * wi;
        acc_i += b0.x * wi + b0.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b1.x * wr - b1.y * wi;
        acc_i += b1.x * wi + b1.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b2.x * wr - b2.y * wi;
        acc_i += b2.x * wi + b2.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b3.x * wr - b3.y * wi;
        acc_i += b3.x * wi + b3.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b4.x * wr - b4.y * wi;
        acc_i += b4.x * wi + b4.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b5.x * wr - b5.y * wi;
        acc_i += b5.x * wi + b5.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b6.x * wr - b6.y * wi;
        acc_i += b6.x * wi + b6.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b7.x * wr - b7.y * wi;
        acc_i += b7.x * wi + b7.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b8.x * wr - b8.y * wi;
        acc_i += b8.x * wi + b8.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b9.x * wr - b9.y * wi;
        acc_i += b9.x * wi + b9.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b10.x * wr - b10.y * wi;
        acc_i += b10.x * wi + b10.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b11.x * wr - b11.y * wi;
        acc_i += b11.x * wi + b11.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b12.x * wr - b12.y * wi;
        acc_i += b12.x * wi + b12.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b13.x * wr - b13.y * wi;
        acc_i += b13.x * wi + b13.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b14.x * wr - b14.y * wi;
        acc_i += b14.x * wi + b14.y * wr;
        { const float nr = wr * step_c - wi * step_s; const float ni = wr * step_s + wi * step_c; wr = nr; wi = ni; }
        acc_r += b15.x * wr - b15.y * wi;
        acc_i += b15.x * wi + b15.y * wr;
        const int out = plane + (h * 16 + m2) * 2;
        row_freq[out] = acc_r * inv_h;
        row_freq[out + 1] = acc_i * inv_h;
    }
}


__global__ void pruned_irfft2_fused_occ16_w64_kernel(int batch_size, int channels, int height,
                       const float *__restrict__ in_freq, float *__restrict__ spatial) {
    __shared__ float sr[16][16];
    __shared__ float si[16][16];
    const int local_row = static_cast<int>(threadIdx.x) >> 4;
    const int m2 = static_cast<int>(threadIdx.x) & 15;
    const int row16 = static_cast<int>(blockIdx.x) * 16 + local_row;
    const int total_rows = batch_size * channels * height;
    const bool valid = row16 < total_rows;
    int h = 0;
    int ch = 0;
    int b = 0;
    int plane = 0;
    if (valid) {
        h = row16 % height;
        int rem = row16 / height;
        ch = rem % channels;
        b = rem / channels;
        plane = ((b * channels + ch) * height) * 32;
        const float two_pi_h = (2.0f * M_PIf) * static_cast<float>(h) / static_cast<float>(height);
        float step_s, step_c;
        sincosf(two_pi_h, &step_s, &step_c);
        float acc_r = 0.0f;
        float acc_i = 0.0f;
        float wr = 1.0f;
        float wi = 0.0f;
#pragma unroll
        for (int m1 = 0; m1 < 16; ++m1) {
            const int top = plane + (m1 * 16 + m2) * 2;
            const float xr = in_freq[top];
            const float xi = in_freq[top + 1];
            acc_r += xr * wr - xi * wi;
            acc_i += xr * wi + xi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        const int kh0 = height - 16;
        sincosf(two_pi_h * static_cast<float>(kh0), &wi, &wr);
#pragma unroll
        for (int m1 = 0; m1 < 16; ++m1) {
            const int bot = plane + ((kh0 + m1) * 16 + m2) * 2;
            const float xr = in_freq[bot];
            const float xi = in_freq[bot + 1];
            acc_r += xr * wr - xi * wi;
            acc_i += xr * wi + xi * wr;
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        const float inv_h = 1.0f / static_cast<float>(height);
        sr[local_row][m2] = acc_r * inv_h;
        si[local_row][m2] = acc_i * inv_h;
    }
    __syncthreads();
    if (!valid) {
        return;
    }
    const float r0 = sr[local_row][0];
    const float r1 = sr[local_row][1];
    const float i1 = si[local_row][1];
    const float r2 = sr[local_row][2];
    const float i2 = si[local_row][2];
    const float r3 = sr[local_row][3];
