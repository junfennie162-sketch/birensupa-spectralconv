static __device__ void dft8_plus(float &r0, float &i0, float &r1, float &i1, float &r2, float &i2, float &r3, float &i3, float &r4, float &i4, float &r5, float &i5, float &r6, float &i6, float &r7, float &i7) {
    { const float tr = r1; r1 = r4; r4 = tr; const float ti = i1; i1 = i4; i4 = ti; }
    { const float tr = r3; r3 = r6; r6 = tr; const float ti = i3; i3 = i6; i6 = ti; }
    // stage 1 len=2
    BF(r0, i0, r1, i1, 1.0f, 0.0f);
    BF(r2, i2, r3, i3, 1.0f, 0.0f);
    BF(r4, i4, r5, i5, 1.0f, 0.0f);
    BF(r6, i6, r7, i7, 1.0f, 0.0f);
    // stage 2 len=4
    BF(r0, i0, r2, i2, 1.0f, 0.0f);
    BF(r1, i1, r3, i3, 0.0f, 1.0f);
    BF(r4, i4, r6, i6, 1.0f, 0.0f);
    BF(r5, i5, r7, i7, 0.0f, 1.0f);
    // stage 3 len=8
    BF(r0, i0, r4, i4, 1.0f, 0.0f);
    BF(r1, i1, r5, i5, 0.707106781f, 0.707106781f);
    BF(r2, i2, r6, i6, 0.0f, 1.0f);
    BF(r3, i3, r7, i7, -0.707106781f, 0.707106781f);
}
static __device__ void dft16_plus(float &r0, float &i0, float &r1, float &i1, float &r2, float &i2, float &r3, float &i3, float &r4, float &i4, float &r5, float &i5, float &r6, float &i6, float &r7, float &i7, float &r8, float &i8, float &r9, float &i9, float &r10, float &i10, float &r11, float &i11, float &r12, float &i12, float &r13, float &i13, float &r14, float &i14, float &r15, float &i15) {
    { const float tr = r1; r1 = r8; r8 = tr; const float ti = i1; i1 = i8; i8 = ti; }
    { const float tr = r2; r2 = r4; r4 = tr; const float ti = i2; i2 = i4; i4 = ti; }
    { const float tr = r3; r3 = r12; r12 = tr; const float ti = i3; i3 = i12; i12 = ti; }
    { const float tr = r5; r5 = r10; r10 = tr; const float ti = i5; i5 = i10; i10 = ti; }
    { const float tr = r7; r7 = r14; r14 = tr; const float ti = i7; i7 = i14; i14 = ti; }
    { const float tr = r11; r11 = r13; r13 = tr; const float ti = i11; i11 = i13; i13 = ti; }
    // stage 1 len=2
    BF(r0, i0, r1, i1, 1.0f, 0.0f);
    BF(r2, i2, r3, i3, 1.0f, 0.0f);
    BF(r4, i4, r5, i5, 1.0f, 0.0f);
    BF(r6, i6, r7, i7, 1.0f, 0.0f);
    BF(r8, i8, r9, i9, 1.0f, 0.0f);
    BF(r10, i10, r11, i11, 1.0f, 0.0f);
    BF(r12, i12, r13, i13, 1.0f, 0.0f);
    BF(r14, i14, r15, i15, 1.0f, 0.0f);
    // stage 2 len=4
    BF(r0, i0, r2, i2, 1.0f, 0.0f);
    BF(r1, i1, r3, i3, 0.0f, 1.0f);
    BF(r4, i4, r6, i6, 1.0f, 0.0f);
    BF(r5, i5, r7, i7, 0.0f, 1.0f);
    BF(r8, i8, r10, i10, 1.0f, 0.0f);
    BF(r9, i9, r11, i11, 0.0f, 1.0f);
    BF(r12, i12, r14, i14, 1.0f, 0.0f);
    BF(r13, i13, r15, i15, 0.0f, 1.0f);
