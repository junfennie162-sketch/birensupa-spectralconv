__global__ void pruned_irfft_w_m16_x4_smem_w256_kernel(int batch_size, int channels, int height,
                       const float *__restrict__ row_freq, float *__restrict__ spatial) {
    __shared__ float2 sb[4][16];
    const int local_row = static_cast<int>(threadIdx.x) >> 6;
    const int pair = static_cast<int>(threadIdx.x) & 63;
    const int total_rows = batch_size * channels * height;
    const int row = static_cast<int>(blockIdx.x) * 4 + local_row;
    const bool valid = row < total_rows;
    int h = 0;
    int ch = 0;
    int b = 0;
    if (valid) {
        h = row % height;
        int rem = row / height;
        ch = rem % channels;
        b = rem / channels;
    }
    const int row_base = ((b * channels + ch) * height + h) * 32;
    if (valid && pair < 16) {
        sb[local_row][pair] = *reinterpret_cast<const float2 *>(row_freq + row_base + pair * 2);
    }
    __syncthreads();
    if (!valid) {
        return;
