        }
        const float inv_h = 1.0f / static_cast<float>(height);
        sr[local_row][m2] = acc_r * inv_h;
        si[local_row][m2] = acc_i * inv_h;
    }
    __syncthreads();
    if (!valid) {
        return;
    }
    const float r0 = sr[local_row][0];
    const float r1 = sr[local_row][1];
    const float i1 = si[local_row][1];
    const float r2 = sr[local_row][2];
    const float i2 = si[local_row][2];
    const float r3 = sr[local_row][3];
    const float i3 = si[local_row][3];
    const float r4 = sr[local_row][4];
    const float i4 = si[local_row][4];
    const float r5 = sr[local_row][5];
    const float i5 = si[local_row][5];
    const float r6 = sr[local_row][6];
    const float i6 = si[local_row][6];
    const float r7 = sr[local_row][7];
    const float i7 = si[local_row][7];
    const float r8 = sr[local_row][8];
    const float i8 = si[local_row][8];
    const float r9 = sr[local_row][9];
    const float i9 = si[local_row][9];
    const float r10 = sr[local_row][10];
    const float i10 = si[local_row][10];
    const float r11 = sr[local_row][11];
    const float i11 = si[local_row][11];
    const float r12 = sr[local_row][12];
    const float i12 = si[local_row][12];
    const float r13 = sr[local_row][13];
    const float i13 = si[local_row][13];
    const float r14 = sr[local_row][14];
    const float i14 = si[local_row][14];
    const float r15 = sr[local_row][15];
    const float i15 = si[local_row][15];
    const float inv_w = 1.0f / static_cast<float>(256);
    const int out_base = ((b * channels + ch) * height + h) * 256;
#pragma unroll
    for (int dw = 0; dw < 8; ++dw) {
        const int w = lane * 8 + dw;
        float acc = r0;
        const float two_pi_w = (2.0f * M_PIf) * static_cast<float>(w) / 256.0f;
        float step_s, step_c;
        sincosf(two_pi_w, &step_s, &step_c);
        float wr = step_c;
        float wi = step_s;
        acc += 2.0f * (r1 * wr - i1 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r2 * wr - i2 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r3 * wr - i3 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r4 * wr - i4 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r5 * wr - i5 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r6 * wr - i6 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r7 * wr - i7 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r8 * wr - i8 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r9 * wr - i9 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r10 * wr - i10 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r11 * wr - i11 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r12 * wr - i12 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r13 * wr - i13 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r14 * wr - i14 * wi);
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc += 2.0f * (r15 * wr - i15 * wi);
        spatial[out_base + w] = acc * inv_w;
    }
}


static __device__ void idft_h_m16_col(const float *__restrict__ in_freq, int plane, int height,
                                      int kh0, float two_pi_h, float step_c, float step_s,
                                      float inv_h, int m2, float &br, float &bi) {
    float acc_r = 0.0f;
    float acc_i = 0.0f;
    float wr = 1.0f;
    float wi = 0.0f;
#pragma unroll
    for (int m1 = 0; m1 < 16; ++m1) {
        const int top = plane + (m1 * 16 + m2) * 2;
        const float xr = in_freq[top];
        const float xi = in_freq[top + 1];
        acc_r += xr * wr - xi * wi;
        acc_i += xr * wi + xi * wr;
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    sincosf(two_pi_h * static_cast<float>(kh0), &wi, &wr);
#pragma unroll
    for (int m1 = 0; m1 < 16; ++m1) {
        const int bot = plane + ((kh0 + m1) * 16 + m2) * 2;
        const float xr = in_freq[bot];
        const float xi = in_freq[bot + 1];
        acc_r += xr * wr - xi * wi;
        acc_i += xr * wi + xi * wr;
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    br = acc_r * inv_h;
    bi = acc_i * inv_h;
}

__global__ void pruned_irfft2_fused_row_m16_kernel(int batch_size, int channels, int height,
                                                   int width, const float *__restrict__ in_freq,
                                                   float *__restrict__ spatial) {
    const int row = static_cast<int>(blockIdx.x * blockDim.x + threadIdx.x);
    const int total = batch_size * channels * height;
    if (row >= total) {
        return;
    }
    const int h = row % height;
    int rem = row / height;
    const int ch = rem % channels;
    const int b = rem / channels;
    const int plane = ((b * channels + ch) * height) * 32;
    const float two_pi_h = (2.0f * M_PIf) * static_cast<float>(h) / static_cast<float>(height);
    float step_s, step_c;
    sincosf(two_pi_h, &step_s, &step_c);
    const float inv_h = 1.0f / static_cast<float>(height);
    const int kh0 = height - 16;
    float br0, bi0, br1, bi1, br2, bi2, br3, bi3, br4, bi4, br5, bi5, br6, bi6, br7, bi7, br8, bi8, br9, bi9, br10, bi10, br11, bi11, br12, bi12, br13, bi13, br14, bi14, br15, bi15;
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 0, br0, bi0);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 1, br1, bi1);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 2, br2, bi2);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 3, br3, bi3);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 4, br4, bi4);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 5, br5, bi5);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 6, br6, bi6);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 7, br7, bi7);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 8, br8, bi8);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 9, br9, bi9);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 10, br10, bi10);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 11, br11, bi11);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 12, br12, bi12);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 13, br13, bi13);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 14, br14, bi14);
    idft_h_m16_col(in_freq, plane, height, kh0, two_pi_h, step_c, step_s, inv_h, 15, br15, bi15);
    const float inv_w = 1.0f / static_cast<float>(width);
    const int out_base = ((b * channels + ch) * height + h) * width;
    float base_s, base_c;
    sincosf((2.0f * M_PIf) / static_cast<float>(width), &base_s, &base_c);
    float pix_c = 1.0f;
    float pix_s = 0.0f;
    for (int w = 0; w < width; w += 2) {
        const float c0 = pix_c;
        const float s0 = pix_s;
        const float c1 = pix_c * base_c - pix_s * base_s;
        const float s1 = pix_c * base_s + pix_s * base_c;
        float acc0 = br0;
        float acc1 = br0;
        float wr0 = c0, wi0 = s0, wr1 = c1, wi1 = s1;
        acc0 += 2.0f * (br1 * wr0 - bi1 * wi0);
        acc1 += 2.0f * (br1 * wr1 - bi1 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br2 * wr0 - bi2 * wi0);
        acc1 += 2.0f * (br2 * wr1 - bi2 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br3 * wr0 - bi3 * wi0);
        acc1 += 2.0f * (br3 * wr1 - bi3 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br4 * wr0 - bi4 * wi0);
        acc1 += 2.0f * (br4 * wr1 - bi4 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br5 * wr0 - bi5 * wi0);
        acc1 += 2.0f * (br5 * wr1 - bi5 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br6 * wr0 - bi6 * wi0);
        acc1 += 2.0f * (br6 * wr1 - bi6 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br7 * wr0 - bi7 * wi0);
        acc1 += 2.0f * (br7 * wr1 - bi7 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br8 * wr0 - bi8 * wi0);
        acc1 += 2.0f * (br8 * wr1 - bi8 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br9 * wr0 - bi9 * wi0);
        acc1 += 2.0f * (br9 * wr1 - bi9 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br10 * wr0 - bi10 * wi0);
        acc1 += 2.0f * (br10 * wr1 - bi10 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br11 * wr0 - bi11 * wi0);
        acc1 += 2.0f * (br11 * wr1 - bi11 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br12 * wr0 - bi12 * wi0);
        acc1 += 2.0f * (br12 * wr1 - bi12 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br13 * wr0 - bi13 * wi0);
        acc1 += 2.0f * (br13 * wr1 - bi13 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br14 * wr0 - bi14 * wi0);
        acc1 += 2.0f * (br14 * wr1 - bi14 * wi1);
        {
            const float n0r = wr0 * c0 - wi0 * s0;
            const float n0i = wr0 * s0 + wi0 * c0;
            wr0 = n0r; wi0 = n0i;
            const float n1r = wr1 * c1 - wi1 * s1;
            const float n1i = wr1 * s1 + wi1 * c1;
            wr1 = n1r; wi1 = n1i;
        }
        acc0 += 2.0f * (br15 * wr0 - bi15 * wi0);
        acc1 += 2.0f * (br15 * wr1 - bi15 * wi1);
        spatial[out_base + w] = acc0 * inv_w;
        spatial[out_base + w + 1] = acc1 * inv_w;
        pix_c = c1 * base_c - s1 * base_s;
        pix_s = c1 * base_s + s1 * base_c;
    }
}


static void launch_1d(unsigned nthreads, dim3 &block, dim3 &grid) {
    block = dim3(256);
    grid = dim3((nthreads + 255u) / 256u);
}

extern "C" suError_t launch_pruned_rfft_w_pack32(const float *x, float *row_freq,
                                                 int batch_size, int channels, int height,
                                                 int modes2, suStream_t stream) {
    const unsigned warps = static_cast<unsigned>(batch_size * channels * height);
    dim3 block(256);
    dim3 grid((warps + 7u) / 8u);
    pruned_rfft_w_pack32_warp_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, height, modes2, x, row_freq);
    return suGetLastError();
}

extern "C" suError_t launch_pruned_rfft_w_geo(const float *x, float *row_freq,
                                              int batch_size, int channels, int height,
                                              int width, int modes2, suStream_t stream) {
    if (modes2 != 16 || (width != 64 && width != 128 && width != 256)) {
        return (suError_t)1;
    }
    dim3 block, grid;
    if (width == 64 && (height & 1) == 0) {
        const unsigned nthreads =
            static_cast<unsigned>(batch_size * channels * (height >> 1) * 16);
        launch_1d(nthreads, block, grid);
        pruned_rfft_w_m16_w64_row2_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
        return suGetLastError();
    }
    const unsigned nthreads =
        static_cast<unsigned>(batch_size * channels * height * 16);
    launch_1d(nthreads, block, grid);
    if (width == 64) {
        pruned_rfft_w_m16_w64_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
    } else if (width == 128) {
        pruned_rfft_w_m16_w128_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
    } else {
        pruned_rfft_w_m16_w256_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
    }
    return suGetLastError();
}

extern "C" suError_t launch_pruned_rfft_w_coop(const float *x, float *row_freq,
                                               int batch_size, int channels, int height,
                                               int width, int modes2, suStream_t stream) {
    if (modes2 != 16 || (width != 64 && width != 128 && width != 256)) {
        return (suError_t)1;
    }
    const unsigned rows = static_cast<unsigned>(batch_size * channels * height);
    dim3 block(256);
    dim3 grid((rows + 15u) / 16u);
    if (width == 64) {
        pruned_rfft_w_m16_w64_coop_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
    } else if (width == 128) {
        pruned_rfft_w_m16_w128_coop_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
    } else {
        pruned_rfft_w_m16_w256_coop_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, x, row_freq);
    }
    return suGetLastError();
}

extern "C" suError_t launch_pruned_fft_h_geo(const float *row_freq, float *packed,
                                             int batch_size, int channels, int height,
                                             int modes1, int modes2, suStream_t stream) {
    if (modes1 != 16 || modes2 != 16) {
        return (suError_t)1;
    }
    const unsigned nthreads =
        static_cast<unsigned>(batch_size * channels * 16 * 16);
    dim3 block, grid;
    launch_1d(nthreads, block, grid);
    if (height == 64) {
        pruned_fft_h_m16_n64_dual_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, row_freq, packed);
        return suGetLastError();
    }
    if (height == 128) {
        pruned_fft_h_m16_n128_dual_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, row_freq, packed);
        return suGetLastError();
    }
    if (height == 256) {
        pruned_fft_h_m16_n256_dual_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, row_freq, packed);
        return suGetLastError();
    }
    return (suError_t)1;
}

extern "C" suError_t launch_pruned_fft_h_coop(const float *row_freq, float *packed,
                                              int batch_size, int channels, int height,
                                              int modes1, int modes2, suStream_t stream) {
    if (modes1 != 16 || modes2 != 16) {
        return (suError_t)1;
    }
    const unsigned cols = static_cast<unsigned>(batch_size * channels * 16);
    dim3 block(256);
    dim3 grid((cols + 7u) / 8u);
    if (height == 64) {
        pruned_fft_h_m16_n64_coop_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, row_freq, packed);
        return suGetLastError();
    }
    if (height == 128) {
        pruned_fft_h_m16_n128_coop_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, row_freq, packed);
        return suGetLastError();
    }
    if (height == 256) {
        pruned_fft_h_m16_n256_coop_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, row_freq, packed);
        return suGetLastError();
    }
    return (suError_t)1;
}

extern "C" suError_t launch_pruned_irfft2_fused(const float *in_freq, float *spatial,
                                                int batch_size, int channels, int height,
                                                int width, int modes1, int modes2,
                                                suStream_t stream) {
    if (modes1 != 16 || modes2 != 16) {
        return (suError_t)1;
    }
    if (width == 64) {
        const unsigned row_groups =
            (static_cast<unsigned>(batch_size * channels * height) + 15u) / 16u;
        dim3 block(256);
        dim3 grid(row_groups);
        pruned_irfft2_fused_occ16_w64_kernel<<<grid, block, 0, stream>>>(
            batch_size, channels, height, in_freq, spatial);
        return suGetLastError();
    }
    const unsigned nthreads = static_cast<unsigned>(batch_size * channels * height);
    dim3 block, grid;
    launch_1d(nthreads, block, grid);
    pruned_irfft2_fused_row_m16_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, height, width, in_freq, spatial);
    return suGetLastError();
}

extern "C" suError_t launch_pruned_ifft_h_x2_named(const float *in_freq, float *row_freq,
                                                   int batch_size, int channels, int height,
                                                   suStream_t stream) {
    const unsigned nthreads =
        static_cast<unsigned>(batch_size * channels * (height >> 1) * 16);
    dim3 block, grid;
    launch_1d(nthreads, block, grid);
    pruned_ifft_h_m16_x2_named_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, height, in_freq, row_freq);
    return suGetLastError();
}

