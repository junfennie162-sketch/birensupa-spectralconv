    packed[top] = acc_tr;
    packed[top + 1] = acc_ti;
    const int bot = ((b * channels + ch) * 256 + kh_bot) * 32 + m2 * 2;
    packed[bot] = acc_br;
    packed[bot + 1] = acc_bi;
}


__global__ void pruned_fft_h_m16_n64_dual_gzt_kernel(int batch_size, int channels,
                       const float *__restrict__ row_freq, float *__restrict__ packed) {
    const int total = batch_size * channels * 16 * 16;
    const int index = static_cast<int>(blockIdx.x * blockDim.x + threadIdx.x);
    if (index >= total) {
        return;
    }
    const int m2 = index & 15;
    int rem = index >> 4;
    const int m1 = rem & 15;
    rem >>= 4;
    const int ch = rem % channels;
    const int b = rem / channels;
    const int kh_bot = 64 - 16 + m1;
    const int row_plane = (b * channels + ch) * 64 * 32;
    const int top = ((b * channels + ch) * 64 + m1) * 32 + m2 * 2;
    const int bot = ((b * channels + ch) * 64 + kh_bot) * 32 + m2 * 2;
    const float two_pi = (2.0f * M_PIf) / static_cast<float>(64);
    if (m1 == 0) {
        float acc_tr = 0.0f;
        float acc_ti = 0.0f;
        float omega = two_pi * static_cast<float>(kh_bot);
        float sn, cs;
        sincosf(omega, &sn, &cs);
        const float coeff = 2.0f * cs;
        float sr1 = 0.0f, sr2 = 0.0f, si1 = 0.0f, si2 = 0.0f;
#pragma unroll 8
        for (int hh = 0; hh < 64; ++hh) {
            const int in = row_plane + (hh * 16 + m2) * 2;
            const float2 xv = *reinterpret_cast<const float2 *>(row_freq + in);
            acc_tr += xv.x;
            acc_ti += xv.y;
            const float sr0 = xv.x + coeff * sr1 - sr2;
            const float si0 = xv.y + coeff * si1 - si2;
            sr2 = sr1;
            sr1 = sr0;
            si2 = si1;
            si1 = si0;
        }
        packed[top] = acc_tr;
        packed[top + 1] = acc_ti;
        packed[bot] = sr1 * cs - sr2 - si1 * sn;
        packed[bot + 1] = sr1 * sn + si1 * cs - si2;
        return;
    }
    float sn_t, cs_t, sn_b, cs_b;
    sincosf(two_pi * static_cast<float>(m1), &sn_t, &cs_t);
    sincosf(two_pi * static_cast<float>(kh_bot), &sn_b, &cs_b);
    const float coeff_t = 2.0f * cs_t;
    const float coeff_b = 2.0f * cs_b;
    float tr1 = 0.0f, tr2 = 0.0f, ti1 = 0.0f, ti2 = 0.0f;
    float br1 = 0.0f, br2 = 0.0f, bi1 = 0.0f, bi2 = 0.0f;
#pragma unroll 8
    for (int hh = 0; hh < 64; ++hh) {
        const int in = row_plane + (hh * 16 + m2) * 2;
        const float2 xv = *reinterpret_cast<const float2 *>(row_freq + in);
        const float tr0 = xv.x + coeff_t * tr1 - tr2;
        const float ti0 = xv.y + coeff_t * ti1 - ti2;
        tr2 = tr1;
        tr1 = tr0;
        ti2 = ti1;
        ti1 = ti0;
        const float br0 = xv.x + coeff_b * br1 - br2;
        const float bi0 = xv.y + coeff_b * bi1 - bi2;
        br2 = br1;
        br1 = br0;
        bi2 = bi1;
        bi1 = bi0;
    }
    packed[top] = tr1 * cs_t - tr2 - ti1 * sn_t;
    packed[top + 1] = tr1 * sn_t + ti1 * cs_t - ti2;
    packed[bot] = br1 * cs_b - br2 - bi1 * sn_b;
    packed[bot + 1] = br1 * sn_b + bi1 * cs_b - bi2;
}


__global__ void pruned_fft_h_m16_n128_dual_gzt_kernel(int batch_size, int channels,
                       const float *__restrict__ row_freq, float *__restrict__ packed) {
    const int total = batch_size * channels * 16 * 16;
    const int index = static_cast<int>(blockIdx.x * blockDim.x + threadIdx.x);
    if (index >= total) {
        return;
    }
    const int m2 = index & 15;
    int rem = index >> 4;
    const int m1 = rem & 15;
    rem >>= 4;
    const int ch = rem % channels;
    const int b = rem / channels;
    const int kh_bot = 128 - 16 + m1;
    const int row_plane = (b * channels + ch) * 128 * 32;
    const int top = ((b * channels + ch) * 128 + m1) * 32 + m2 * 2;
    const int bot = ((b * channels + ch) * 128 + kh_bot) * 32 + m2 * 2;
    const float two_pi = (2.0f * M_PIf) / static_cast<float>(128);
    if (m1 == 0) {
        float acc_tr = 0.0f;
        float acc_ti = 0.0f;
        float omega = two_pi * static_cast<float>(kh_bot);
        float sn, cs;
        sincosf(omega, &sn, &cs);
        const float coeff = 2.0f * cs;
        float sr1 = 0.0f, sr2 = 0.0f, si1 = 0.0f, si2 = 0.0f;
#pragma unroll 8
        for (int hh = 0; hh < 128; ++hh) {
            const int in = row_plane + (hh * 16 + m2) * 2;
            const float2 xv = *reinterpret_cast<const float2 *>(row_freq + in);
            acc_tr += xv.x;
            acc_ti += xv.y;
            const float sr0 = xv.x + coeff * sr1 - sr2;
            const float si0 = xv.y + coeff * si1 - si2;
            sr2 = sr1;
            sr1 = sr0;
            si2 = si1;
            si1 = si0;
        }
        packed[top] = acc_tr;
        packed[top + 1] = acc_ti;
        packed[bot] = sr1 * cs - sr2 - si1 * sn;
        packed[bot + 1] = sr1 * sn + si1 * cs - si2;
        return;
    }
    float sn_t, cs_t, sn_b, cs_b;
    sincosf(two_pi * static_cast<float>(m1), &sn_t, &cs_t);
    sincosf(two_pi * static_cast<float>(kh_bot), &sn_b, &cs_b);
    const float coeff_t = 2.0f * cs_t;
    const float coeff_b = 2.0f * cs_b;
    float tr1 = 0.0f, tr2 = 0.0f, ti1 = 0.0f, ti2 = 0.0f;
    float br1 = 0.0f, br2 = 0.0f, bi1 = 0.0f, bi2 = 0.0f;
#pragma unroll 8
    for (int hh = 0; hh < 128; ++hh) {
        const int in = row_plane + (hh * 16 + m2) * 2;
        const float2 xv = *reinterpret_cast<const float2 *>(row_freq + in);
        const float tr0 = xv.x + coeff_t * tr1 - tr2;
        const float ti0 = xv.y + coeff_t * ti1 - ti2;
        tr2 = tr1;
        tr1 = tr0;
        ti2 = ti1;
        ti1 = ti0;
        const float br0 = xv.x + coeff_b * br1 - br2;
        const float bi0 = xv.y + coeff_b * bi1 - bi2;
        br2 = br1;
        br1 = br0;
        bi2 = bi1;
        bi1 = bi0;
    }
    packed[top] = tr1 * cs_t - tr2 - ti1 * sn_t;
    packed[top + 1] = tr1 * sn_t + ti1 * cs_t - ti2;
    packed[bot] = br1 * cs_b - br2 - bi1 * sn_b;
    packed[bot + 1] = br1 * sn_b + bi1 * cs_b - bi2;
}


__global__ void pruned_fft_h_m16_n256_dual_gzt_kernel(int batch_size, int channels,
                       const float *__restrict__ row_freq, float *__restrict__ packed) {
    const int total = batch_size * channels * 16 * 16;
    const int index = static_cast<int>(blockIdx.x * blockDim.x + threadIdx.x);
    if (index >= total) {
        return;
    }
    const int m2 = index & 15;
    int rem = index >> 4;
    const int m1 = rem & 15;
    rem >>= 4;
    const int ch = rem % channels;
    const int b = rem / channels;
    const int kh_bot = 256 - 16 + m1;
    const int row_plane = (b * channels + ch) * 256 * 32;
    const int top = ((b * channels + ch) * 256 + m1) * 32 + m2 * 2;
    const int bot = ((b * channels + ch) * 256 + kh_bot) * 32 + m2 * 2;
    const float two_pi = (2.0f * M_PIf) / static_cast<float>(256);
    if (m1 == 0) {
        float acc_tr = 0.0f;
        float acc_ti = 0.0f;
        float omega = two_pi * static_cast<float>(kh_bot);
        float sn, cs;
        sincosf(omega, &sn, &cs);
        const float coeff = 2.0f * cs;
        float sr1 = 0.0f, sr2 = 0.0f, si1 = 0.0f, si2 = 0.0f;
#pragma unroll 8
        for (int hh = 0; hh < 256; ++hh) {
            const int in = row_plane + (hh * 16 + m2) * 2;
            const float2 xv = *reinterpret_cast<const float2 *>(row_freq + in);
            acc_tr += xv.x;
            acc_ti += xv.y;
            const float sr0 = xv.x + coeff * sr1 - sr2;
            const float si0 = xv.y + coeff * si1 - si2;
            sr2 = sr1;
            sr1 = sr0;
            si2 = si1;
            si1 = si0;
        }
        packed[top] = acc_tr;
        packed[top + 1] = acc_ti;
        packed[bot] = sr1 * cs - sr2 - si1 * sn;
        packed[bot + 1] = sr1 * sn + si1 * cs - si2;
        return;
    }
    float sn_t, cs_t, sn_b, cs_b;
    sincosf(two_pi * static_cast<float>(m1), &sn_t, &cs_t);
    sincosf(two_pi * static_cast<float>(kh_bot), &sn_b, &cs_b);
    const float coeff_t = 2.0f * cs_t;
    const float coeff_b = 2.0f * cs_b;
    float tr1 = 0.0f, tr2 = 0.0f, ti1 = 0.0f, ti2 = 0.0f;
    float br1 = 0.0f, br2 = 0.0f, bi1 = 0.0f, bi2 = 0.0f;
#pragma unroll 8
    for (int hh = 0; hh < 256; ++hh) {
        const int in = row_plane + (hh * 16 + m2) * 2;
        const float2 xv = *reinterpret_cast<const float2 *>(row_freq + in);
        const float tr0 = xv.x + coeff_t * tr1 - tr2;
        const float ti0 = xv.y + coeff_t * ti1 - ti2;
        tr2 = tr1;
        tr1 = tr0;
        ti2 = ti1;
        ti1 = ti0;
        const float br0 = xv.x + coeff_b * br1 - br2;
        const float bi0 = xv.y + coeff_b * bi1 - bi2;
        br2 = br1;
        br1 = br0;
        bi2 = bi1;
        bi1 = bi0;
    }
    packed[top] = tr1 * cs_t - tr2 - ti1 * sn_t;
    packed[top + 1] = tr1 * sn_t + ti1 * cs_t - ti2;
    packed[bot] = br1 * cs_b - br2 - bi1 * sn_b;
    packed[bot + 1] = br1 * sn_b + bi1 * cs_b - bi2;
}


__global__ void pruned_fft_h_m16_n64_coop_kernel(int batch_size, int channels,
                       const float *__restrict__ row_freq, float *__restrict__ packed) {
    __shared__ float cr[8][65];
    __shared__ float ci[8][65];
    const int local_col = static_cast<int>(threadIdx.x) >> 5;
    const int lane = static_cast<int>(threadIdx.x) & 31;
    const int total_cols = batch_size * channels * 16;
    const int col = static_cast<int>(blockIdx.x) * 8 + local_col;
    int b = 0;
    int ch = 0;
    int m2 = 0;
    if (col < total_cols) {
        m2 = col & 15;
        int rem = col >> 4;
        ch = rem % channels;
        b = rem / channels;
        const int row_plane = (b * channels + ch) * 64 * 32;
#pragma unroll 4
        for (int hh = lane; hh < 64; hh += 32) {
            const int in = row_plane + (hh * 16 + m2) * 2;
            cr[local_col][hh] = row_freq[in];
            ci[local_col][hh] = row_freq[in + 1];
        }
    }
    __syncthreads();
    if (col >= total_cols) {
        return;
    }
    const int m1 = lane & 15;
    const int corner = lane >> 4;
    const int kh = (corner == 0) ? m1 : (64 - 16 + m1);
    const float two_pi_k = -(2.0f * M_PIf) * static_cast<float>(kh) / static_cast<float>(64);
    float step_s, step_c;
    sincosf(two_pi_k, &step_s, &step_c);
    float acc_r = 0.0f;
    float acc_i = 0.0f;
    float wr = 1.0f;
    float wi = 0.0f;
#pragma unroll 8
    for (int hh = 0; hh < 64; ++hh) {
        const float xr = cr[local_col][hh];
        const float xi = ci[local_col][hh];
        acc_r += xr * wr - xi * wi;
        acc_i += xr * wi + xi * wr;
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    const int out = ((b * channels + ch) * 64 + kh) * 32 + m2 * 2;
    packed[out] = acc_r;
    packed[out + 1] = acc_i;
}


__global__ void pruned_fft_h_m16_n128_coop_kernel(int batch_size, int channels,
                       const float *__restrict__ row_freq, float *__restrict__ packed) {
    __shared__ float cr[8][129];
    __shared__ float ci[8][129];
