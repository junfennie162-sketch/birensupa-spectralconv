    const float two_pi = (2.0f * M_PIf) / static_cast<float>(256);
    float step_ts, step_tc, step_bs, step_bc;
    sincosf(-two_pi * static_cast<float>(m1), &step_ts, &step_tc);
    sincosf(-two_pi * static_cast<float>(kh_bot), &step_bs, &step_bc);
    float acc_tr = 0.0f;
    float acc_ti = 0.0f;
    float acc_br = 0.0f;
    float acc_bi = 0.0f;
