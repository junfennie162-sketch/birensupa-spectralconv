        acc0r += v0.x * wr;
        acc0i += v0.x * wi;
        acc1r += v1.x * wr;
        acc1i += v1.x * wi;
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
            wi = ni;
        }
        acc0r += v0.y * wr;
        acc0i += v0.y * wi;
        acc1r += v1.y * wr;
        acc1i += v1.y * wi;
        {
            const float nr = wr * step_c - wi * step_s;
            const float ni = wr * step_s + wi * step_c;
            wr = nr;
