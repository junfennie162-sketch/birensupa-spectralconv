    float r22 = x[x_base + 26];
    float i22 = x[x_base + 27];
    float r14 = x[x_base + 28];
    float i14 = x[x_base + 29];
    float r30 = x[x_base + 30];
    float i30 = x[x_base + 31];
    float r1 = x[x_base + 32];
    float i1 = x[x_base + 33];
    float r17 = x[x_base + 34];
    float i17 = x[x_base + 35];
    float r9 = x[x_base + 36];
    float i9 = x[x_base + 37];
    float r25 = x[x_base + 38];
    float i25 = x[x_base + 39];
    float r5 = x[x_base + 40];
    float i5 = x[x_base + 41];
    float r21 = x[x_base + 42];
    float i21 = x[x_base + 43];
    float r13 = x[x_base + 44];
    float i13 = x[x_base + 45];
    float r29 = x[x_base + 46];
    float i29 = x[x_base + 47];
    float r3 = x[x_base + 48];
    float i3 = x[x_base + 49];
    float r19 = x[x_base + 50];
    float i19 = x[x_base + 51];
    float r11 = x[x_base + 52];
    float i11 = x[x_base + 53];
    float r27 = x[x_base + 54];
    float i27 = x[x_base + 55];
    float r7 = x[x_base + 56];
    float i7 = x[x_base + 57];
    float r23 = x[x_base + 58];
    float i23 = x[x_base + 59];
    float r15 = x[x_base + 60];
    float i15 = x[x_base + 61];
    float r31 = x[x_base + 62];
    float i31 = x[x_base + 63];
    fft32_regs(r0, i0, r1, i1, r2, i2, r3, i3, r4, i4, r5, i5, r6, i6, r7, i7, r8, i8, r9, i9, r10, i10, r11, i11, r12, i12, r13, i13, r14, i14, r15, i15, r16, i16, r17, i17, r18, i18, r19, i19, r20, i20, r21, i21, r22, i22, r23, i23, r24, i24, r25, i25, r26, i26, r27, i27, r28, i28, r29, i29, r30, i30, r31, i31);
    float *out = row_freq + ((b * channels + ch) * height + h) * modes2 * 2;
    out[0] = r0 + i0;
    out[1] = 0.0f;
    {
        const float zr = r1;
        const float zi = i1;
        const float znr = r31;
        const float zni = i31;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[2] = hr + gr * 0.995184727f - gi * -0.098017140f;
        out[3] = hi + gr * -0.098017140f + gi * 0.995184727f;
    }
    {
        const float zr = r2;
        const float zi = i2;
        const float znr = r30;
        const float zni = i30;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[4] = hr + gr * 0.980785280f - gi * -0.195090322f;
        out[5] = hi + gr * -0.195090322f + gi * 0.980785280f;
    }
    {
        const float zr = r3;
        const float zi = i3;
        const float znr = r29;
        const float zni = i29;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[6] = hr + gr * 0.956940336f - gi * -0.290284677f;
        out[7] = hi + gr * -0.290284677f + gi * 0.956940336f;
    }
    {
        const float zr = r4;
        const float zi = i4;
        const float znr = r28;
        const float zni = i28;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[8] = hr + gr * 0.923879533f - gi * -0.382683432f;
        out[9] = hi + gr * -0.382683432f + gi * 0.923879533f;
    }
    {
        const float zr = r5;
        const float zi = i5;
        const float znr = r27;
        const float zni = i27;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[10] = hr + gr * 0.881921264f - gi * -0.471396737f;
        out[11] = hi + gr * -0.471396737f + gi * 0.881921264f;
    }
    {
        const float zr = r6;
        const float zi = i6;
        const float znr = r26;
        const float zni = i26;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[12] = hr + gr * 0.831469612f - gi * -0.555570233f;
        out[13] = hi + gr * -0.555570233f + gi * 0.831469612f;
    }
    {
        const float zr = r7;
        const float zi = i7;
        const float znr = r25;
        const float zni = i25;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[14] = hr + gr * 0.773010453f - gi * -0.634393284f;
        out[15] = hi + gr * -0.634393284f + gi * 0.773010453f;
    }
    {
        const float zr = r8;
        const float zi = i8;
        const float znr = r24;
        const float zni = i24;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[16] = hr + gr * 0.707106781f - gi * -0.707106781f;
        out[17] = hi + gr * -0.707106781f + gi * 0.707106781f;
    }
    {
        const float zr = r9;
        const float zi = i9;
        const float znr = r23;
        const float zni = i23;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[18] = hr + gr * 0.634393284f - gi * -0.773010453f;
        out[19] = hi + gr * -0.773010453f + gi * 0.634393284f;
    }
    {
        const float zr = r10;
        const float zi = i10;
        const float znr = r22;
        const float zni = i22;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[20] = hr + gr * 0.555570233f - gi * -0.831469612f;
        out[21] = hi + gr * -0.831469612f + gi * 0.555570233f;
    }
    {
        const float zr = r11;
        const float zi = i11;
        const float znr = r21;
        const float zni = i21;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[22] = hr + gr * 0.471396737f - gi * -0.881921264f;
        out[23] = hi + gr * -0.881921264f + gi * 0.471396737f;
    }
    {
        const float zr = r12;
        const float zi = i12;
        const float znr = r20;
        const float zni = i20;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
        const float gr = 0.5f * (zi + zni);
        const float gi = 0.5f * (znr - zr);
        out[24] = hr + gr * 0.382683432f - gi * -0.923879533f;
        out[25] = hi + gr * -0.923879533f + gi * 0.382683432f;
    }
    {
        const float zr = r13;
        const float zi = i13;
        const float znr = r19;
        const float zni = i19;
        const float hr = 0.5f * (zr + znr);
        const float hi = 0.5f * (zi - zni);
