    b6r += r6 * wr - i6 * wi;
    b6i += r6 * wi + i6 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b7r += r7 * wr - i7 * wi;
    b7i += r7 * wi + i7 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b0r += r8 * wr - i8 * wi;
    b0i += r8 * wi + i8 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b1r += r9 * wr - i9 * wi;
    b1i += r9 * wi + i9 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b2r += r10 * wr - i10 * wi;
    b2i += r10 * wi + i10 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b3r += r11 * wr - i11 * wi;
    b3i += r11 * wi + i11 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b4r += r12 * wr - i12 * wi;
    b4i += r12 * wi + i12 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b5r += r13 * wr - i13 * wi;
    b5i += r13 * wi + i13 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b6r += r14 * wr - i14 * wi;
    b6i += r14 * wi + i14 * wr;
    {
        const float nr = wr * step_c - wi * step_s;
        const float ni = wr * step_s + wi * step_c;
        wr = nr;
        wi = ni;
    }
    b7r += r15 * wr - i15 * wi;
    b7i += r15 * wi + i15 * wr;
    dft8_plus(b0r, b0i, b1r, b1i, b2r, b2i, b3r, b3i, b4r, b4i, b5r, b5i, b6r, b6i, b7r, b7i);

    const float invw = 1.0f / 128.0f;
    spatial[out_base + n1_w + 0] = (2.0f * b0r - r0) * invw;
    spatial[out_base + n1_w + 16] = (2.0f * b1r - r0) * invw;
    spatial[out_base + n1_w + 32] = (2.0f * b2r - r0) * invw;
    spatial[out_base + n1_w + 48] = (2.0f * b3r - r0) * invw;
    spatial[out_base + n1_w + 64] = (2.0f * b4r - r0) * invw;
    spatial[out_base + n1_w + 80] = (2.0f * b5r - r0) * invw;
    spatial[out_base + n1_w + 96] = (2.0f * b6r - r0) * invw;
    spatial[out_base + n1_w + 112] = (2.0f * b7r - r0) * invw;
    }
}

extern "C" suError_t launch_pruned_irfft2_fused_mixed128_n4(const float *in_freq, float *spatial,
                                                        int batch_size, int channels,
                                                        suStream_t stream) {
    dim3 block(256);
    dim3 grid(static_cast<unsigned>(batch_size * channels * 4));
    pruned_irfft2_fused_mixed128_n4_kernel<<<grid, block, 0, stream>>>(
        batch_size, channels, in_freq, spatial);
    return suGetLastError();
}
